if (!exists("read_base_progress", mode="function")) {
read_base_progress <- function(pf){
  if (file.exists(pf) && file.info(pf) > 0) {
    utils::read.csv(pf, stringsAsFactors=FALSE)
  } else {
    data.frame(stage=character(), pid=character(), status=character(), t=as.POSIXct(character()))
  }
}
}
pivot_longer_safe <- function(data, ..., names_to = "name", values_to = "value") {
  build_empty <- function(data, names_to, values_to) {
    id_cols <- intersect(c("Sample","Gene"), names(data))
    if (!length(id_cols) && length(names(data))) id_cols <- names(data)[1]
    out <- tibble::tibble()
    for (id in id_cols) out[[id]] <- data[[id]][0]
    out[[names_to]] <- vector(mode = "character", length = 0)
    out[[values_to]] <- vector(mode = "numeric",   length = 0)
    out
  }
  if (is.null(data) || !is.data.frame(data) || ncol(data) <= 1) {
    return(build_empty(data, names_to, values_to))
  }
  tryCatch(
    tidyr::pivot_longer_safe(data, ..., names_to = names_to, values_to = values_to),
    error = function(e) build_empty(data, names_to, values_to)
  )
}
# Mask file.copy everywhere (workers included)
file.copy <- function(from, to, ...) safe_copy(from, to, ...)
#!/usr/bin/env Rscript

# 12_wgs_exact_compare.R (patched)
# Whole-genome, high-resolution comparison workflow
# Adds: preflight checks, progress heartbeat, robust joins, and VF report fix.

options(stringsAsFactors = FALSE, warn = 1)

suppressPackageStartupMessages({
  library(optparse)
  library(jsonlite)
  library(data.table)
  library(dplyr)
  library(tidyr)

safe_pivot_longer <- function(df){
  if (!'Sample' %in% names(df))
    return(tibble::tibble(Sample=character(), Sample2=character(), SNPs=integer()));
  others <- setdiff(names(df), 'Sample')
  if (!length(others))
    return(tibble::tibble(Sample=character(), Sample2=character(), SNPs=integer()));
  tidyr::pivot_longer_safe(df, -Sample, names_to='Sample2', values_to='SNPs')
}

  library(stringr)
  library(purrr)
  library(ggplot2)
  library(readr)
  library(future.apply)
  library(igraph)
  library(pheatmap)
  library(tibble)
  library(gridExtra)
})
# --- safe, single-threaded progress IO (avoid vroom on files being written) ---
read_progress <- function(pf) {
  if (!file.exists(pf)) {
    return(tibble::tibble(stage=character(), pid=character(), status=character(), t=as.POSIXct(character())))
  }
  sz <- suppressWarnings(file.size(pf))
  if (is.na(sz) || sz == 0) {
    return(tibble::tibble(stage=character(), pid=character(), status=character(), t=as.POSIXct(character())))
  }
  out <- data.table::fread(pf, nThread = 1, showProgress = FALSE)
  tibble::as_tibble(out)
}

write_progress <- function(df, pf) {
  dir.create(dirname(pf), recursive = TRUE, showWarnings = FALSE)
  tmp <- paste0(pf, ".tmp")
  readr::write_csv(df, tmp)
  file.rename(tmp, pf)
}

# If you want to force vroom to 1 thread, do it *inside R*, not bash:
options(vroom.num_threads = 1L)
# ---- Safe pheatmap wrapper (sanitizes matrix, no clustering) ----
# ---- Safe file copy wrapper (skips self-copy and makes parent dirs) ----
# Mask file.copy everywhere (workers included)
file.copy <- function(from, to, ...) safe_copy(from, to, ...)
safe_copy <- function(from, to, overwrite = TRUE) {
  nf <- tryCatch(normalizePath(from, winslash = "/", mustWork = FALSE), error = function(e) from)
  nt <- tryCatch(normalizePath(to,   winslash = "/", mustWork = FALSE), error = function(e) to)
  if (identical(nf, nt)) return(TRUE)  # nothing to do
  dir.create(dirname(to), recursive = TRUE, showWarnings = FALSE)
  ok <- base::file.copy(from, to, overwrite = overwrite)
  if (!ok) warning("safe_copy: failed to copy '", from, "' -> '", to, "'")
  ok
}
safe_pheatmap <- function(mat, ...) {
  mat <- suppressWarnings(apply(as.matrix(mat), 2, as.numeric))
  mat <- as.matrix(mat)
  if (!isSymmetric(unname(mat))) mat <- pmax(mat, t(mat), na.rm = TRUE)
  mat[!is.finite(mat)] <- NA
  if (anyNA(mat)) {
    mx <- suppressWarnings(max(mat, na.rm = TRUE)); if (!is.finite(mx)) mx <- 0
    mat[is.na(mat)] <- mx + 1
  }
  if (nrow(mat) < 2 || ncol(mat) < 2) return(invisible(NULL))
  diag(mat) <- 0
  pheatmap::pheatmap(mat, cluster_rows = FALSE, cluster_cols = FALSE, ...)
}

