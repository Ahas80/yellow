  make_option("--mash_max", type = "double", default = 0.02,
              help = "Heuristic threshold for Mash distance (default 0.02)"),
  make_option("--pan_jaccard_max", type = "double", default = 0.05,
              help = "Heuristic threshold for Pan-Jaccard distance (default 0.05)"),
  make_option("--threads", type = "integer", default = 8,
