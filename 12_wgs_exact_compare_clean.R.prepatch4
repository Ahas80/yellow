# ============================== HELPERS =======================================

msg <- function(fmt, ...) {
  cat(sprintf("[%s] %s\n", format(Sys.time(), "%Y-%m-%d %H:%M:%S"), sprintf(fmt, ...)))
  flush.console()
}

nzchr <- function(x) ifelse(is.na(x), "", x)

check_bin <- function(bin_candidates) {
  hits <- Sys.which(bin_candidates)
  p <- hits[hits != ""]
  if (length(p)) return(unname(p[1]))
  ""
}

run_cmd <- function(cmd,
                    args = character(),
                    log_file = NULL,
                    env = character(),
                    echo = FALSE,
                    fail_ok = FALSE) {
  write_log <- function(lines) {
    dir.create(dirname(log_file), recursive = TRUE, showWarnings = FALSE)
    con <- file(log_file, open = if (file.exists(log_file)) "at" else "wt")
    on.exit(close(con), add = TRUE)
    lines <- as.character(lines)
    if (!length(lines)) lines <- "<no output>"
    writeLines(lines, con)
  }
  
  if (is.null(log_file)) {
    log_file <- file.path(
      base_out, "logs",
      paste0(gsub("[^A-Za-z0-9_]+", "_", basename(cmd)), "_", as.integer(Sys.time()), ".log")
    )
  }
  if (echo) msg("CMD: %s %s", cmd, paste(args, collapse = " "))
  
  res <- tryCatch({
    out <- system2(command = cmd, args = args, stdout = TRUE, stderr = TRUE, env = env)
    write_log(out)
    structure(out, status = 0L)
  }, warning = function(w) {
    write_log(c("=== WARNING ===", capture.output(w)))
    structure(character(), status = 0L)
  }, error = function(e) {
    write_log(c("=== ERROR ===", capture.output(e)))
    structure(character(), status = 1L)
  })
  
  status <- attr(res, "status"); if (is.null(status)) status <- 0L
  if (status != 0L && !fail_ok) {
    msg("⚠️  Command failed (status=%s). See %s", status, log_file)
  }
  invisible(list(status = status, log = log_file))
}

tp_norm <- function(x) {
  x <- as.character(x)
  is_uricult <- str_detect(x, regex("uricult", ignore_case = TRUE))
  tp_num <- suppressWarnings(as.integer(str_extract(x, "\\d+")))
  tp_lab <- case_when(
    is_uricult ~ "Uricult",
    !is.na(tp_num) ~ paste0("T", tp_num),
    TRUE ~ "Unscheduled"
  )
  tibble(tp_lab = tp_lab, tp_num = tp_num)
}

# FASTA metrics: N50 & total length
fasta_stats <- function(fa) {
  if (is.na(fa) || !nzchar(fa) || !file.exists(fa)) {
    return(tibble(n_contigs = NA_integer_, n50 = NA_real_, total_bp = NA_real_))
  }
  L <- readLines(fa, warn = FALSE)
  sel <- which(startsWith(L, ">"))
  lens <- integer()
  if (length(sel)) {
    starts <- c(sel, length(L) + 1)
    for (i in seq_along(sel)) {
      seq_lines <- L[(sel[i] + 1):(starts[i + 1] - 1)]
      seq_lines <- seq_lines[seq_lines != ""]
      lens <- c(lens, sum(nchar(seq_lines)))
    }
  } else {
    lens <- sum(nchar(L[!startsWith(L, ">")]))
  }
  lens <- sort(lens, decreasing = TRUE)
  total <- sum(lens)
  n50 <- if (total > 0) {
    cum <- cumsum(lens)
    lens[min(which(cum >= total/2))]
  } else NA_real_
  tibble(n_contigs = length(lens), n50 = as.numeric(n50), total_bp = as.numeric(total))
}

safe_read_csv <- function(p) { if (file.exists(p)) suppressMessages(readr::read_csv(p, show_col_types = FALSE)) else NULL }
safe_read_tsv <- function(p) { if (file.exists(p)) suppressMessages(readr::read_tsv(p, show_col_types = FALSE)) else NULL }

write_plot <- function(p, path, w = 8, h = 6, dpi = 300) {
  if (inherits(p, "ggplot")) try(ggsave(path, p, width = w, height = h, dpi = dpi), silent = TRUE)
}

tool_version <- function(bin, args = c("--version")) {
  if (bin == "") return(NA_character_)
  out <- tryCatch(system2(bin, args, stdout = TRUE, stderr = TRUE), error = function(e) NULL)
  if (is.null(out) || length(out) == 0) {
    out <- tryCatch(system2(bin, c("--help"), stdout = TRUE, stderr = TRUE), error = function(e) NULL)
  }
  if (is.null(out) || length(out) == 0) return(NA_character_)
  paste(head(out, 3), collapse = " | ")
}

pair_key <- function(a, b) { paste(pmin(a, b), pmax(a, b), sep = "||") }

# -------- Heartbeat progress (CSV + small rolling bar chart) -------------------
progress_tick <- function(stage, pid = NA_character_, status = "tick") {
  pf <- file.path(base_out, "reports", "progress.csv")
  if (file.exists(pf)) {
    df <- suppressMessages(read_base_progress(pf),
        pid    = readr::col_character(),   # <-- force character
        status = readr::col_character(),
        t      = readr::col_datetime()
      ),
      show_col_types = FALSE
    ))
  } else {
    df <- tibble(stage=character(), pid=character(), status=character(), t=as.POSIXct(character()))
  }
  df <- dplyr::bind_rows(
    df,
    tibble(
      stage  = as.character(stage),
      pid    = as.character(nzchr(pid)),
      status = as.character(status),
      t      = Sys.time()
    )
  )
  utils::write.csv(df, pf, row.names=FALSE)
  
  # tiny progress plot (unchanged)
  plotf <- file.path(plot_dir, "_progress.png")
  summ <- df %>% count(stage, status, name = "n")
  p <- ggplot(summ, aes(stage, n, fill = status)) +
    geom_col() + coord_flip() +
    labs(title = "Pipeline progress (rolling)", x = NULL, y = "Events") +
    theme_minimal(base_size = 10)
  write_plot(p, plotf, 6, 4, 150)
}
# =========================== DISCOVER SAMPLES =================================
msg("Discovering assemblies and reads…")

# Vectorized, safe parser for PID / timepoint from filenames
parse_pid_tp <- function(paths) {
  if (length(paths) == 0) {
    return(tibble(Participant_id = character(), Timepoint = character()))
  }
  stems <- tools::file_path_sans_ext(basename(paths))
  PID <- stringr::str_extract(stems, "^[A-Za-z0-9]+")
  TP1 <- stringr::str_extract(stems, "(?i)(T\\d+|Uricult|U\\d+)")
  num <- suppressWarnings(as.integer(stringr::str_extract(stems, "(?<=_)\\d+|(?<=-)\\d+")))
  TP  <- ifelse(is.na(TP1) & !is.na(num), paste0("T", num), TP1)
  tibble(Participant_id = PID, Timepoint = TP)
}

# Assemblies
asm_files <- list.files(asm_dir, pattern = "\\.(fa|fasta|fna)(\\.gz)?$", full.names = TRUE)

# Reads (R1/R2), keep only proper pairs
reads_R1 <- list.files(reads_dir, pattern = "_R1\\.(fastq|fq)(\\.gz)?$", full.names = TRUE)
reads_R2 <- gsub("_R1\\.(fastq|fq)(\\.gz)?$", "_R2.\\1\\2", reads_R1, perl = TRUE)
paired_ok <- file.exists(reads_R2)
reads_R1 <- reads_R1[paired_ok]
reads_R2 <- reads_R2[paired_ok]

if (!length(asm_files)) msg("⚠️  No assemblies found under %s", asm_dir)
if (!length(reads_R1))  msg("⚠️  No paired reads found under %s", reads_dir)

# Build samples from assemblies if present; else from reads; else empty
if (length(asm_files) > 0) {
  samples_from_asm <- tibble(
    assembly = asm_files,
    SampleID = tools::file_path_sans_ext(basename(asm_files))
  )
  samples <- samples_from_asm %>%
    bind_cols(parse_pid_tp(samples_from_asm$assembly)) %>%
    mutate(Timepoint = dplyr::coalesce(Timepoint, "Unscheduled"))
} else if (length(reads_R1) > 0) {
  samples_from_reads <- tibble(
    R1 = reads_R1,
    R2 = reads_R2,
    SampleID = sub("_R1\\.(fastq|fq)(\\.gz)?$", "", basename(reads_R1))
  )
  samples <- samples_from_reads %>%
    bind_cols(parse_pid_tp(samples_from_reads$SampleID)) %>%
    mutate(Timepoint = dplyr::coalesce(Timepoint, "Unscheduled"),
           assembly  = NA_character_)
} else {
  samples <- tibble(assembly = character(), SampleID = character(),
                    Participant_id = character(), Timepoint = character())
}

# Attach reads by SampleID if present
if (nrow(samples) > 0 && length(reads_R1) > 0) {
  reads_tbl <- tibble(R1 = reads_R1, R2 = reads_R2) %>%
    mutate(SampleID = sub("_R1\\.(fastq|fq)(\\.gz)?$", "", basename(R1)))
  samples <- samples %>% left_join(reads_tbl, by = "SampleID")
} else {
  if (!"R1" %in% names(samples)) samples$R1 <- NA_character_
  if (!"R2" %in% names(samples)) samples$R2 <- NA_character_
}

# If the prep step ran, use its authoritative mapping (SampleID / PID / Timepoint)
if (file.exists("assembly_metadata.csv") && "assembly" %in% names(samples)) {
  assembly_df <- readr::read_csv("assembly_metadata.csv", show_col_types = FALSE) %>%
    dplyr::mutate(
      assembly            = file.path(asm_dir, file_name),
      SampleID_meta       = dplyr::coalesce(as.character(Isolate_ID),
                                            tools::file_path_sans_ext(file_name)),
      Participant_id_meta = as.character(Participant_id),
      Timepoint_meta      = as.character(Timepoint)
    ) %>%
    dplyr::select(assembly, SampleID_meta, Participant_id_meta, Timepoint_meta)
  
  samples <- samples %>%
    dplyr::left_join(assembly_df, by = "assembly") %>%
    dplyr::mutate(
      SampleID       = dplyr::coalesce(SampleID_meta, SampleID),
      Participant_id = dplyr::coalesce(Participant_id_meta, Participant_id),
      Timepoint      = dplyr::coalesce(Timepoint_meta, Timepoint)
    ) %>%
    dplyr::select(-SampleID_meta, -Participant_id_meta, -Timepoint_meta)
}

# ---- de-duplicate to avoid many-to-many joins later
samples <- samples %>% distinct(SampleID, .keep_all = TRUE)

# Compute assembly stats only where assembly exists
msg("Computing assembly N50 metrics…")
if (!"assembly" %in% names(samples)) samples$assembly <- NA_character_
samples <- samples %>%
  mutate(stats = purrr::map(assembly, fasta_stats)) %>%
  tidyr::unnest(stats)

# Normalize timepoints
if (nrow(samples) > 0) {
  tp <- tp_norm(samples$Timepoint)
  samples <- samples %>% mutate(tp_lab = tp$tp_lab, tp_num = tp$tp_num)
} else {
  samples <- samples %>% mutate(tp_lab = character(), tp_num = as.integer(NA))
}

# Optional PID restriction
if (!identical(toupper(opt$pids), "ALL") && nrow(samples) > 0) {
  keep_pids <- strsplit(opt$pids, ",", fixed = TRUE)[[1]] |> trimws()
  samples <- samples %>% filter(Participant_id %in% keep_pids)
}
samples <- samples %>% mutate(
  SampleID       = as.character(SampleID),
  Participant_id = as.character(Participant_id),
  Timepoint      = as.character(Timepoint)
)
all_pids <- samples %>%
  filter(!is.na(Participant_id), Participant_id != "") %>%
  distinct(Participant_id) %>% pull()

msg("Discovered %d samples across %d participants.", nrow(samples), length(all_pids))

# ---- Augment with MLST (optional, robust to empty table) ----
mlst_matrix <- safe_read_csv("results/mlst/mlst_matrix.csv")
if (!is.null(mlst_matrix) && nrow(samples) > 0) {
  sid_col <- intersect(c("SampleID", "Isolate_ID"), names(mlst_matrix))
  sid_col <- if (length(sid_col)) sid_col[1] else NULL
  if (!is.null(sid_col)) {
    mm <- mlst_matrix %>%
      transmute(
        SampleID = as.character(.data[[sid_col]]),
        Participant_id = dplyr::coalesce(as.character(Participant_id), NA_character_),
        Timepoint      = dplyr::coalesce(as.character(Timepoint), NA_character_),
        ST             = dplyr::coalesce(as.character(ST), NA_character_)
      ) %>%
      group_by(SampleID) %>%                     # collapse duplicates
      summarise(
        Participant_id = first(na.omit(Participant_id)),
        Timepoint      = first(na.omit(Timepoint)),
        ST             = first(na.omit(ST)),
        .groups = "drop"
      )
    
    samples <- samples %>%
      mutate(SampleID = as.character(SampleID)) %>%
      left_join(mm, by = "SampleID", relationship = "many-to-one") %>%
      mutate(
        Participant_id = dplyr::coalesce(Participant_id.y, Participant_id.x),
        Timepoint      = dplyr::coalesce(Timepoint.y, Timepoint.x),
        ST             = dplyr::coalesce(ST, NA_character_)
      ) %>%
      select(-ends_with(".x"), -ends_with(".y")) %>%
      distinct(SampleID, .keep_all = TRUE)
    
    tp <- tp_norm(samples$Timepoint)
    samples <- samples %>% mutate(tp_lab = tp$tp_lab, tp_num = tp$tp_num)
  }
}

# ========================== TOOL DISCOVERY & PARAMS ============================

BIN_minimap2 <- check_bin(c("minimap2"))
BIN_samtools <- check_bin(c("samtools"))
BIN_bcftools <- check_bin(c("bcftools"))
BIN_gubbins  <- check_bin(c("gubbins", "run_gubbins.py"))
BIN_snpdists <- check_bin(c("snp-dists"))
BIN_mash     <- check_bin(c("mash"))
BIN_panaroo  <- check_bin(c("panaroo"))
BIN_roary    <- check_bin(c("roary"))
BIN_nucmer   <- check_bin(c("nucmer"))
BIN_showdiff <- check_bin(c("show-diff"))
BIN_showcoords <- check_bin(c("show-coords"))
BIN_mosdepth <- check_bin(c("mosdepth"))
BIN_bedtools <- check_bin(c("bedtools"))
BIN_syri     <- check_bin(c("syri"))

params <- list(
  timestamp = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
  args = opt,
  tools = list(
    minimap2 = tool_version(BIN_minimap2),
    samtools = tool_version(BIN_samtools),
    bcftools = tool_version(BIN_bcftools),
    gubbins  = tool_version(BIN_gubbins),
    snp_dists= tool_version(BIN_snpdists),
    mash     = tool_version(BIN_mash),
    panaroo  = tool_version(BIN_panaroo),
    roary    = tool_version(BIN_roary),
    nucmer   = tool_version(BIN_nucmer),
    show_diff= tool_version(BIN_showdiff),
    show_coords = tool_version(BIN_showcoords),
    mosdepth = tool_version(BIN_mosdepth),
    bedtools = tool_version(BIN_bedtools),
    syri     = tool_version(BIN_syri)
  )
)
writeLines(jsonlite::toJSON(params, pretty = TRUE, auto_unbox = TRUE), file.path(base_out, "params_wgs.json"))

# Preflight module readiness
ready <- list(
  A = all(c(BIN_minimap2, BIN_samtools, BIN_bcftools) != ""),
  B = (BIN_mash != ""),
  C = ((BIN_panaroo != "" || BIN_roary != "")),
  D = (BIN_nucmer != "" && (BIN_showdiff != "" || BIN_showcoords != "")),
  E = (BIN_bcftools != ""),
  F = (BIN_mash != ""),
  H = (BIN_snpdists != "")
)
msg("Preflight — A:%s B:%s C:%s D:%s E:%s F:%s H:%s",
    ready$A, ready$B, ready$C, ready$D, ready$E, ready$F, ready$H)

prefer_reads <- function(s) {
  if (opt$mode == "reads") return(TRUE)
  if (opt$mode == "assemblies") return(FALSE)
  !is.na(s$R1) & !is.na(s$R2) & file.exists(s$R1) & file.exists(s$R2)
}

# ============================== A) CORE SNPs ==================================
A_results <- list()
if (ready$A) {
  msg("A) CORE SNP analysis starting…"); progress_tick("A_CORE", status = "start")
  bam_dir <- file.path(base_out, "bam")
  dir.create(bam_dir, recursive = TRUE, showWarnings = FALSE)
  
  pick_ref_for_pid <- function(df_pid) {
    dfp <- df_pid %>%
      filter(!is.na(assembly) & file.exists(assembly)) %>%
      arrange(is.na(tp_num), tp_num, desc(n50), desc(total_bp))
    if (nrow(dfp) == 0) return(tibble(ref_fa = NA_character_, ref_sample = NA_character_))
    tibble(ref_fa = dfp$assembly[1], ref_sample = dfp$SampleID[1])
  }
  
  make_bam_for_sample <- function(ref_fa, srow) {
    s <- srow
    out_bam   <- file.path(bam_dir, s$Participant_id, paste0(s$SampleID, ".markdup.bam"))
    out_bai   <- paste0(out_bam, ".bai")
    dir.create(dirname(out_bam), recursive = TRUE, showWarnings = FALSE)
    if (file.exists(out_bam) && file.exists(out_bai)) return(out_bam)
    
    if (prefer_reads(s)) {
      sam_sort <- file.path(bam_dir, s$Participant_id, paste0(s$SampleID, ".sorted.bam"))
      args_map <- c("-t", opt$threads, "-ax", "sr", shQuote(ref_fa), shQuote(s$R1), shQuote(s$R2))
      cmd <- sprintf("%s %s | %s sort -@ %d -o %s", BIN_minimap2, paste(args_map, collapse = " "),
                     BIN_samtools, opt$threads, shQuote(sam_sort))
      run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", paste0("map_", s$SampleID, ".log")), fail_ok = TRUE)
      run_cmd(BIN_samtools, c("markdup", "-@", opt$threads, "-s", shQuote(sam_sort), shQuote(out_bam)), fail_ok = TRUE)
      run_cmd(BIN_samtools, c("index", shQuote(out_bam)), fail_ok = TRUE)
      unlink(sam_sort)
    } else {
      sam_sort <- file.path(bam_dir, s$Participant_id, paste0(s$SampleID, ".sorted.bam"))
      args_map <- c("-t", opt$threads, "-ax", "asm10", shQuote(ref_fa), shQuote(s$assembly))
      cmd <- sprintf("%s %s | %s sort -@ %d -o %s", BIN_minimap2, paste(args_map, collapse = " "),
                     BIN_samtools, opt$threads, shQuote(sam_sort))
      run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", paste0("map_", s$SampleID, ".log")), fail_ok = TRUE)
      run_cmd(BIN_samtools, c("markdup", "-@", opt$threads, "-s", shQuote(sam_sort), shQuote(out_bam)), fail_ok = TRUE)
      run_cmd(BIN_samtools, c("index", shQuote(out_bam)), fail_ok = TRUE)
      unlink(sam_sort)
    }
    out_bam
  }
  
  callable_bp_mosdepth <- function(bam, min_depth = opt$min_depth) {
    if (BIN_mosdepth == "") return(NA_real_)
    prefix <- file.path(dirname(bam), paste0(basename(bam), ".mosdepth"))
    if (!file.exists(paste0(prefix, ".global.dist.txt"))) {
      run_cmd(BIN_mosdepth, c("-t", opt$threads, "--no-per-base", "--fast-mode", "-n", prefix, bam),
              log_file = file.path(base_out, "logs", paste0("mosdepth_", basename(bam), ".log")), fail_ok = TRUE)
    }
    p <- paste0(prefix, ".global.dist.txt")
    if (!file.exists(p)) return(NA_real_)
    df <- tryCatch(read_tsv(p, col_names = c("chrom","depth","count"), show_col_types = FALSE), error = function(e) NULL)
    if (is.null(df)) return(NA_real_)
    df %>% filter(depth >= min_depth) %>% summarise(sum = sum(count, na.rm = TRUE)) %>% pull(sum) %>% as.numeric()
  }
  
  future::plan(future::multisession, workers = max(1, opt$threads %/% 2))
  on.exit(future::plan(future::sequential), add = TRUE)
  
  A_results <- future_lapply(all_pids, function(pid) {
    df_pid <- samples %>% filter(Participant_id == pid)
    if (!nrow(df_pid)) return(NULL)
    ref <- pick_ref_for_pid(df_pid)
    ref_fa <- ref$ref_fa; ref_sample <- ref$ref_sample
    if (is.na(ref_fa) || !file.exists(ref_fa)) {
      msg("↪  PID %s: no usable assembly reference; skipping core SNPs.", pid)
      progress_tick("A_CORE", pid, "no_ref")
      return(NULL)
    }
    msg("PID %s: reference=%s (%s)", pid, basename(ref_fa), ref_sample)
    
    # BAMs
    bams <- lapply(split(df_pid, df_pid$SampleID), function(s) make_bam_for_sample(ref_fa, s))
    bam_vec <- unlist(bams)
    bam_list_file <- file.path(base_out, "core", paste0("bam_list_", pid, ".txt"))
    writeLines(bam_vec, bam_list_file)
    
    # Joint mpileup+call
    vcf_out <- file.path(base_out, "core", paste0("joint_", pid, ".vcf.gz"))
    if (!file.exists(vcf_out)) {
      mp_cmd <- c("mpileup", "-f", shQuote(ref_fa), "-a", "AD,DP", "-q", 0, "-Q", opt$min_qual,
                  "-Ou", "-b", shQuote(bam_list_file))
      call_cmd <- c("call", "-mv", "-Oz", "-o", shQuote(vcf_out))
      cmd <- sprintf("%s %s | %s %s", BIN_bcftools, paste(mp_cmd, collapse = " "),
                     BIN_bcftools, paste(call_cmd, collapse = " "))
      run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", paste0("bcf_call_", pid, ".log")), fail_ok = TRUE)
      run_cmd(BIN_bcftools, c("index", "-t", shQuote(vcf_out)), fail_ok = TRUE)
    }
    
    # Consensus per sample
    cons_dir <- file.path(base_out, "core", paste0("consensus_", pid))
    dir.create(cons_dir, showWarnings = FALSE, recursive = TRUE)
    cons_fastas <- c()
    for (sid in df_pid$SampleID) {
      cons_fa <- file.path(cons_dir, paste0(sid, ".fa"))
      if (!file.exists(cons_fa)) {
        run_cmd(BIN_bcftools, c("view", "-s", sid, "-Oz", "-o", shQuote(file.path(cons_dir, paste0("tmp_", sid, ".vcf.gz"))), shQuote(vcf_out)), fail_ok = TRUE)
        run_cmd(BIN_bcftools, c("index", "-t", shQuote(file.path(cons_dir, paste0("tmp_", sid, ".vcf.gz")))), fail_ok = TRUE)
        cmd <- sprintf("%s consensus -f %s -s %s %s > %s",
                       BIN_bcftools, shQuote(ref_fa), shQuote(sid),
                       shQuote(file.path(cons_dir, paste0("tmp_", sid, ".vcf.gz"))), shQuote(cons_fa))
        run_cmd("/bin/sh", c("-c", cmd),
                log_file = file.path(base_out, "logs", paste0("consensus_redir_", pid, "_", sid, ".log")),
                fail_ok = TRUE)
      }
      cons_fastas <- c(cons_fastas, cons_fa)
    }
    # Concatenate multi-FASTA
    multi_fa <- file.path(base_out, "core", paste0("multi_", pid, ".fa"))
    if (!file.exists(multi_fa)) {
      cat("", file = multi_fa)
      for (fa in cons_fastas) {
        L <- readLines(fa, warn = FALSE)
        header <- paste0(">", tools::file_path_sans_ext(basename(fa)))
        seq <- paste(L[!startsWith(L, ">")], collapse = "")
        cat(c(header, gsub("(.{1,80})", "\\1\n", seq, perl = TRUE)), file = multi_fa, sep = "n", append = TRUE)
      }
    }
    
    # Run Gubbins if available
    core_align <- file.path(base_out, "core", paste0("core_alignment_", pid, ".fa"))
    core_tree  <- file.path(base_out, "core", paste0("core_tree_", pid, ".nwk"))
    mask_bed   <- file.path(base_out, "masks", paste0("mask_catalog_", pid, ".bed"))
    if (BIN_gubbins != "") {
      outdir <- file.path(base_out, "core", paste0("gubbins_", pid))
      dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
      args_gub <- if (basename(BIN_gubbins) == "gubbins") {
        sprintf('%s --threads %d --prefix %s --outgroup %s %s',
                BIN_gubbins, opt$threads, shQuote(paste0("run_", pid)), shQuote(ref_sample), shQuote(multi_fa))
      } else {
        sprintf('%s --threads %d --prefix %s %s',
                BIN_gubbins, opt$threads, shQuote(paste0("run_", pid)), shQuote(multi_fa))
      }
      run_cmd("/bin/sh", c("-c", sprintf("cd %s && %s", shQuote(outdir), args_gub)),
              log_file = file.path(base_out, "logs", paste0("gubbins_", pid, ".log")), fail_ok = TRUE)
      cand_align <- list.files(outdir, pattern = "filtered_polymorphic_sites\\.fa(sta)?$", full.names = TRUE)
      if (length(cand_align)) safe_copy(cand_align[1], core_align, overwrite = TRUE)
      cand_tree <- list.files(outdir, pattern = "(final_tree|filtered_polymorphic_sites).*\\.tre$", full.names = TRUE)
      if (length(cand_tree)) safe_copy(cand_tree[1], core_tree, overwrite = TRUE)
      
      gff <- list.files(outdir, pattern = "recombination_predictions\\.gff$", full.names = TRUE)
      if (length(gff)) {
        gdat <- suppressWarnings(read_tsv(gff[1], comment = "#", col_names = FALSE, show_col_types = FALSE))
        if (nrow(gdat)) {
          bed <- gdat %>%
            transmute(chrom = X1, start = pmax(1, as.integer(X4) - 1), end = as.integer(X5))
          dir.create(dirname(mask_bed), recursive = TRUE, showWarnings = FALSE)
          write_tsv(bed, mask_bed, col_names = FALSE)
        }
      }
    } else {
      msg("↪  gubbins not found; using unmasked multi-FASTA as core for PID %s", pid)
      safe_copy(multi_fa, core_align, overwrite = TRUE)
    }
    
    # snp-dists
    dist_tsv <- tempfile(fileext = ".tsv")
    if (BIN_snpdists != "" && file.exists(core_align)) {
      cmd <- sprintf("%s -c %s > %s", BIN_snpdists, shQuote(core_align), shQuote(dist_tsv))
      run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", paste0("snpdists_", pid, ".log")), fail_ok = TRUE)
    }
    
    # Parse SNP matrix
    snp_mat <- NULL
    if (file.exists(dist_tsv)) {
      df <- suppressWarnings(read_tsv(dist_tsv, show_col_types = FALSE))
      if (nrow(df) > 0) { colnames(df)[1] <- "Sample"; snp_mat <- df }
    }
    
    pairs <- tibble()
    if (!is.null(snp_mat)) {
      long <- snp_mat %>% pivot_longer_safe(-Sample, names_to = "Sample2", values_to = "SNPs") %>%
        filter(Sample != Sample2)
      long <- long %>% mutate(pair_id = pair_key(Sample, Sample2)) %>%
        arrange(pair_id) %>% distinct(pair_id, .keep_all = TRUE)
      callable_tbl <- tibble(SampleID = df_pid$SampleID, bam = bam_vec) %>%
        mutate(callable_bp = map_dbl(bam, ~ callable_bp_mosdepth(.x, opt$min_depth)))
      callable_map <- callable_tbl %>% select(SampleID, callable_bp)
      long <- long %>%
        left_join(callable_map, by = c("Sample" = "SampleID")) %>% rename(callable_A = callable_bp) %>%
        left_join(callable_map, by = c("Sample2" = "SampleID")) %>% rename(callable_B = callable_bp)
      overlap_callable <- pmin(long$callable_A, long$callable_B, na.rm = TRUE)
      long$overlap_callable_bp <- overlap_callable
      long$SNPs_per_Mb <- ifelse(!is.na(overlap_callable) & overlap_callable > 0,
                                 long$SNPs / (overlap_callable / 1e6), NA_real_)
      long$Participant_id <- pid
      long$SampleA <- long$Sample; long$SampleB <- long$Sample2
      pairs <- long %>% select(Participant_id, SampleA, SampleB, SNPs, callable_A, callable_B, overlap_callable_bp, SNPs_per_Mb)
      
      # Heatmap
      mat <- as.matrix(as.data.frame(snp_mat[,-1]))
      rownames(mat) <- snp_mat$Sample
      png(file.path(plot_dir, paste0("core_snp_heatmap_", pid, ".png")), width = 1200, height = 1000, res = 150)
      invisible(safe_pheatmap(mat, clustering_distance_rows = "euclidean", clustering_distance_cols = "euclidean",
                     main = paste("Core SNPs:", pid)))
      dev.off()
    }
    
    # Time vs SNP distance
    time_plot_file <- file.path(plot_dir, paste0("time_vs_snp_distance_", pid, ".png"))
    if (!is.null(pairs) && nrow(pairs)) {
      df_pid_tp <- samples %>% filter(Participant_id == pid) %>% select(SampleID, tp_num) %>% distinct()
      tlong <- pairs %>%
        left_join(df_pid_tp, by = c("SampleA" = "SampleID")) %>% rename(tp_A = tp_num) %>%
        left_join(df_pid_tp, by = c("SampleB" = "SampleID")) %>% rename(tp_B = tp_num) %>%
        mutate(delta_tp = abs(tp_B - tp_A)) %>% filter(!is.na(delta_tp))
      p <- ggplot(tlong, aes(delta_tp, SNPs_per_Mb)) +
        geom_point() + geom_smooth(method = "lm", se = FALSE) +
        labs(title = paste0("Time vs SNPs/Mb (", pid, ")"), x = "|Δ timepoint|", y = "SNPs per Mb")
      write_plot(p, time_plot_file, 6, 4)
    }
    
    core_align_out <- file.path(base_out, "core", paste0("core_alignment_", pid, ".fa"))
    if (file.exists(core_align)) safe_copy(core_align, core_align_out, overwrite = TRUE)
    if (file.exists(core_tree)) safe_copy(core_tree, file.path(base_out, "core", paste0("core_tree_", pid, ".nwk")), overwrite = TRUE)
    
    progress_tick("A_CORE", pid, "done")
    list(pid = pid, core_alignment = core_align_out,
         core_tree = if (file.exists(file.path(base_out, "core", paste0("core_tree_", pid, ".nwk")))) file.path(base_out, "core", paste0("core_tree_", pid, ".nwk")) else NA_character_,
         pairwise = pairs)
  })
  
  A_pairs <- bind_rows(purrr::compact(lapply(A_results, function(x) x$pairwise)))
  if (nrow(A_pairs) > 0) {
    A_pairs %>% group_by(Participant_id) %>%
      group_walk(~ readr::write_csv(.x, file.path(base_out, "core", paste0("core_snp_matrix_", unique(.x$Participant_id), ".csv"))))
  }
} else {
  msg("↪  Skipping A) CORE SNPs: require minimap2+samtools+bcftools on PATH.")
}

# ========================== B) ASSEMBLY-FREE k-MER =============================
kmer_mat_file <- file.path(base_out, "kmer", "kmer_dist_matrix.csv")
kmer_long_file <- file.path(base_out, "kmer", "kmer_pairs_long.csv")
ani_vs_kmer_plot <- file.path(plot_dir, "ani_vs_kmer_scatter.png")

if (ready$B) {
  msg("B) Mash all-vs-all distances…"); progress_tick("B_MASH", status = "start")
  sk_dir <- file.path(base_out, "kmer", "sketches")
  dir.create(sk_dir, recursive = TRUE, showWarnings = FALSE)
  
  samples <- samples %>% mutate(
    use_reads = ifelse(opt$mode == "reads", TRUE,
                       ifelse(opt$mode == "assemblies", FALSE,
                              !is.na(R1) & !is.na(R2) & file.exists(R1) & file.exists(R2))))
  inputs <- samples %>%
    mutate(input = ifelse(use_reads, paste(shQuote(R1), shQuote(R2)), shQuote(assembly))) %>%
    distinct(SampleID, input)
  
  msh_files <- c()
  for (i in seq_len(nrow(inputs))) {
    sid <- inputs$SampleID[i]
    msh <- file.path(sk_dir, paste0(sid, ".msh"))
    if (!file.exists(msh)) {
      inps <- inputs$input[i]
      cmd <- sprintf("%s sketch -p %d -o %s %s", BIN_mash, opt$threads, shQuote(msh), inps)
      run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", paste0("mash_sketch_", sid, ".log")), fail_ok = TRUE)
    }
    msh_files <- c(msh_files, msh)
    progress_tick("B_MASH", sid, "sketched")
  }
  
  all_dist <- file.path(base_out, "kmer", "mash_all_vs_all.tab")
  combined <- file.path(sk_dir, "combined")
  cmd <- sprintf("%s paste %s %s", BIN_mash, shQuote(combined), paste(shQuote(msh_files), collapse = " "))
  run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", "mash_paste.log"), fail_ok = TRUE)
  cmd <- sprintf("%s dist -p %d %s %s > %s",
                 BIN_mash, opt$threads,
                 shQuote(paste0(combined, ".msh")), shQuote(paste0(combined, ".msh")), shQuote(all_dist))
  run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", "mash_dist.log"), fail_ok = TRUE)
  
  if (file.exists(all_dist)) {
    md <- read_tsv(all_dist, col_names = FALSE, show_col_types = FALSE)
    if (nrow(md)) {
      names(md) <- c("A","B","Mash_distance","pvalue","shared_hashes")
      md <- md %>%
        mutate(A = tools::file_path_sans_ext(basename(A)),
               B = tools::file_path_sans_ext(basename(B))) %>%
        mutate(pair_id = pair_key(A,B)) %>%
        arrange(pair_id) %>% distinct(pair_id, .keep_all = TRUE) %>%
        filter(A != B)
      write_csv(md, kmer_long_file)
      sids <- sort(unique(c(md$A, md$B)))
      mat <- matrix(0, nrow = length(sids), ncol = length(sids), dimnames = list(sids, sids))
      for (i in seq_len(nrow(md))) {
        mat[md$A[i], md$B[i]] <- md$Mash_distance[i]
        mat[md$B[i], md$A[i]] <- md$Mash_distance[i]
      }
      write_csv(as.data.frame(mat) %>% rownames_to_column("SampleID"), kmer_mat_file)
      
      pair11 <- safe_read_csv("results/within_person/pairwise_summary.csv")
      if (!is.null(pair11)) {
        ani_col <- intersect(c("ani","ANI","nucmer_ANI"), names(pair11))
        if (length(ani_col)) {
          join <- pair11 %>% rename(A = 1, B = 2) %>%
            rename_with(~"ANI", ani_col[1]) %>%
            mutate(A = as.character(A), B = as.character(B))
          plotdf <- md %>% left_join(join, by = c("A","B"))
          p <- ggplot(plotdf, aes(Mash_distance, ANI, color = ANI)) + geom_point(alpha = 0.6) +
            labs(title = "ANI vs Mash distance", x = "Mash distance", y = "ANI") + theme_minimal()
          write_plot(p, ani_vs_kmer_plot, 6, 5)
        }
      }
    }
  }
  progress_tick("B_MASH", status = "done")
} else {
  msg("↪  Skipping B) Mash: mash not found on PATH.")
}

# ========================= C) PAN-GENOME PRES/ABS ==============================
gpa_mat_file <- file.path(base_out, "pangenome", "gpa_matrix_cohort.csv")
pan_pairs_file <- file.path(base_out, "pangenome", "pan_jaccard_pairs.csv")
pan_hist_plot <- file.path(plot_dir, "pan_jaccard_hist_by_call.png")

gff_dirs <- c("data/assemblies", "results/prokka", "data/gff")
gffs <- unique(unlist(lapply(gff_dirs, function(d) if (dir.exists(d)) list.files(d, pattern = "\\.gff(3)?$", full.names = TRUE) else character())))
if (ready$C && length(gffs) >= 3) {
  msg("C) Pan-genome with %s (n GFF=%d)…", ifelse(BIN_panaroo != "", "panaroo", "roary"), length(gffs))
  progress_tick("C_PAN", status = "start")
  pan_dir <- file.path(base_out, "pangenome", "cohort")
  dir.create(pan_dir, recursive = TRUE, showWarnings = FALSE)
  if (BIN_panaroo != "") {
    args <- c("-i", paste(shQuote(gffs), collapse = " "), "-o", shQuote(pan_dir), "-t", opt$threads, "--clean-mode", "strict", "--remove-invalid-genes")
    cmd <- sprintf("%s %s", BIN_panaroo, paste(args, collapse = " "))
    run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", "panaroo.log"), fail_ok = TRUE)
    gpa_file <- file.path(pan_dir, "gene_presence_absence.csv")
  } else {
    args <- c("-e", "-n", "-v", "-p", opt$threads, "-f", shQuote(pan_dir), paste(shQuote(gffs), collapse = " "))
    cmd <- sprintf("%s %s", BIN_roary, paste(args, collapse = " "))
    run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", "roary.log"), fail_ok = TRUE)
    gpa_file <- file.path(pan_dir, "gene_presence_absence.csv")
  }
  if (file.exists(gpa_file)) {
    gpa <- suppressMessages(read_csv(gpa_file, show_col_types = FALSE))
    iso_cols <- names(gpa)[grepl("\\.gff", names(gpa), ignore.case = TRUE)]
    if (!length(iso_cols)) {
      iso_cols <- setdiff(names(gpa), c("Gene","Non-unique Gene name","Annotation", "No. isolates","No. sequences","Avg sequences per isolate","Genome Fragment","Order within Fragment","Accessory Fragment","Accessory Order with Fragment", "QC"))
    }
    pa <- gpa %>%
      select(Gene = 1, all_of(iso_cols)) %>%
      pivot_longer_safe(-Gene, names_to = "Isolate", values_to = "val") %>%
      mutate(present = as.integer(nzchar(val))) %>%
      select(-val) %>%
      mutate(SampleID = tools::file_path_sans_ext(basename(Isolate))) %>%
      group_by(SampleID, Gene) %>% summarise(present = max(present, na.rm = TRUE), .groups = "drop") %>%
      pivot_wider(names_from = Gene, values_from = present, values_fill = 0)
    write_csv(pa, gpa_mat_file)
    
    bin <- pa %>% column_to_rownames("SampleID") %>% as.matrix()
    jaccard <- function(a, b) { inter <- sum(a & b); uni <- sum(a | b); if (uni == 0) NA_real_ else 1 - inter/uni }
    sids <- rownames(bin)
    pan_pairs <- expand.grid(A = sids, B = sids, stringsAsFactors = FALSE) %>%
      filter(A < B) %>%
      rowwise() %>%
      mutate(Pan_Jaccard = jaccard(bin[A, ] > 0, bin[B, ] > 0)) %>%
      ungroup()
    write_csv(pan_pairs, pan_pairs_file)
    
    pair11 <- safe_read_csv("results/within_person/pairwise_summary.csv")
    if (!is.null(pair11)) {
      labcol <- intersect(c("call","same_strain_call","label"), names(pair11))
      if (length(labcol)) {
        j <- pair11 %>% rename(A = 1, B = 2) %>% rename(call = !!labcol[1]) %>%
          mutate(A = as.character(A), B = as.character(B))
        plotdf <- pan_pairs %>% left_join(j, by = c("A","B"))
        p <- ggplot(plotdf, aes(Pan_Jaccard, fill = call)) +
          geom_histogram(alpha = 0.7, position = "identity", bins = 30) +
          labs(title = "Pan-Jaccard distribution by call") + theme_minimal()
        write_plot(p, pan_hist_plot, 7, 5)
      }
    }
    
    for (pid in all_pids) {
      sid_pid <- samples %>% filter(Participant_id == pid) %>% pull(SampleID)
      sub <- pa %>% filter(SampleID %in% sid_pid)
      if (nrow(sub) >= 2) {
        mat <- sub %>% column_to_rownames("SampleID") %>% as.matrix()
        png(file.path(plot_dir, paste0("pan_heatmap_", pid, ".png")), width = 1400, height = 1000, res = 150)
        safe_pheatmap(mat, cluster_rows = TRUE, cluster_cols = TRUE, main = paste("Pan-genome presence/absence:", pid))
        dev.off()
      }
    }
  }
  progress_tick("C_PAN", status = "done")
} else {
  msg("↪  Skipping C) Pangenome: need panaroo/roary + ≥3 GFFs.")
}

# ====================== D) STRUCTURAL VARIANT SUMMARY =========================
sv_pairs_file <- file.path(base_out, "sv", "sv_pairs.csv")
sv_plot_file  <- file.path(plot_dir, "sv_counts_vs_ani.png")

if (ready$D) {
  msg("D) SV summary via nucmer/show-diff…"); progress_tick("D_SV", status = "start")
  sv_rows <- list()
  for (pid in all_pids) {
    dfp <- samples %>% filter(Participant_id == pid)
    if (nrow(dfp) < 2) next
    comb <- t(combn(dfp$SampleID, 2))
    for (i in seq_len(nrow(comb))) {
      a <- comb[i, 1]; b <- comb[i, 2]
      fa <- dfp$assembly[dfp$SampleID == a][1]
      fb <- dfp$assembly[dfp$SampleID == b][1]
      outdir <- file.path(base_out, "sv", paste0(pid, "_", a, "_vs_", b))
      dir.create(outdir, recursive = TRUE, showWarnings = FALSE)
      pref <- file.path(outdir, "run")
      run_cmd(BIN_nucmer, c("--mum", "--prefix", shQuote(pref), shQuote(fa), shQuote(fb)),
              log_file = file.path(base_out, "logs", paste0("nucmer_sv_", pid, "_", a, "_", b, ".log")), fail_ok = TRUE)
      delta <- paste0(pref, ".delta")
      if (!file.exists(delta)) { progress_tick("D_SV", pid, "nucmer_failed"); next }
      
      diff_file <- file.path(outdir, "showdiff.txt")
      cmd <- sprintf("%s -q -T %s > %s", BIN_showdiff, shQuote(delta), shQuote(diff_file))
      run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", paste0("showdiff_", pid, "_", a, "_", b, ".log")), fail_ok = TRUE)
      
      ins <- del <- inv <- trans <- 0L
      ins_bp <- del_bp <- inv_bp <- trans_bp <- 0
      if (file.exists(diff_file)) {
        df <- suppressWarnings(read_tsv(diff_file, col_names = FALSE, show_col_types = FALSE))
        if (nrow(df)) {
          type_col <- which(sapply(df, function(c) all(nchar(unique(na.omit(c))) <= 2)))
          if (length(type_col)) {
            tcol <- type_col[1]
            num_cols <- which(sapply(df, function(x) all(grepl("^\\d+$", nzchr(x)))))
            lcol <- if (length(num_cols)) num_cols[length(num_cols)] else NA_integer_
            types <- df[[tcol]]
            lens  <- if (!is.na(lcol)) as.numeric(df[[lcol]]) else rep(1, nrow(df))
            ins   <- sum(types == "I", na.rm = TRUE); del <- sum(types == "D", na.rm = TRUE)
            inv   <- sum(types == "R", na.rm = TRUE); trans <- sum(types == "T", na.rm = TRUE)
            ins_bp <- sum(lens[types == "I"], na.rm = TRUE)
            del_bp <- sum(lens[types == "D"], na.rm = TRUE)
            inv_bp <- sum(lens[types == "R"], na.rm = TRUE)
            trans_bp <- sum(lens[types == "T"], na.rm = TRUE)
          }
        }
      }
      sv_rows[[length(sv_rows) + 1]] <- tibble(
        Participant_id = as.character(pid),
        A = as.character(a),
        B = as.character(b),
        insertions = as.integer(ins),
        deletions = as.integer(del),
        inversions = as.integer(inv),
        translocations = as.integer(trans),
        ins_bp = as.numeric(ins_bp),
        del_bp = as.numeric(del_bp),
        inv_bp = as.numeric(inv_bp),
        trans_bp = as.numeric(trans_bp),
        SV_bp_total = as.numeric(sum(ins_bp, del_bp, inv_bp, trans_bp, na.rm = TRUE))
      )
      progress_tick("D_SV", pid, "pair_done")
    }
  }
  if (length(sv_rows)) {
    sv_pairs <- bind_rows(sv_rows) %>% distinct(A, B, .keep_all = TRUE)
    write_csv(sv_pairs, sv_pairs_file)
    sv_pairs <- bind_rows(sv_rows) %>%
      mutate(across(c(Participant_id, A, B), as.character)) %>%
      distinct(A, B, .keep_all = TRUE)
    pair11 <- safe_read_csv("results/within_person/pairwise_summary.csv")
    if (!is.null(pair11)) {
      anicol <- intersect(c("ani","ANI","nucmer_ANI"), names(pair11))
      if (length(anicol)) {
        j <- pair11 %>% rename(A = 1, B = 2) %>% rename(ANI = !!anicol[1]) %>% mutate(A = as.character(A), B = as.character(B))
        dfp <- sv_pairs %>% left_join(j, by = c("A","B"))
        p <- ggplot(dfp, aes(ANI, SV_bp_total)) + geom_point(alpha = 0.6) +
          labs(title = "SV bp total vs ANI", x = "ANI", y = "SV total bp") + theme_minimal()
        write_plot(p, sv_plot_file, 6, 5)
      }
    }
  }
  progress_tick("D_SV", status = "done")
} else {
  msg("↪  Skipping D) SV: need nucmer + show-diff/coords.")
}
# Immediately after you create/augment `samples` (before computing all_pids):
samples <- samples %>% mutate(
  SampleID = as.character(SampleID),
  Participant_id = as.character(Participant_id),
  Timepoint = as.character(Timepoint)
)
# ================== E) WITHIN-TIMEPOINT SUBCLONE SIGNAL (VAF) =================
vaf_csv <- file.path(base_out, "vaf", "het_snp_summary.csv")
if (ready$E) {
  msg("E) VAF / heterozygous site summary…"); progress_tick("E_VAF", status = "start")
  vaf_rows <- list()
  joint_vcfs <- list.files(file.path(base_out, "core"), pattern = "^joint_.*\\.vcf\\.gz$", full.names = TRUE)
  for (vcf in joint_vcfs) {
    pid <- str_match(basename(vcf), "^joint_(.*)\\.vcf\\.gz$")[,2]
    smps <- system2(BIN_bcftools, c("query", "-l", vcf), stdout = TRUE)
    for (s in smps) {
      fmt <- "%CHROM\t%POS\t[%AD]\t[%DP]\n"
      cmd <- sprintf("%s query -s %s -f '%s' %s | awk -F'\\t' 'NF>=4 && $3!=\".\" && $4!=\".\" {split($3,a,\",\"); if (length(a)>=2 && $4>0) {v=a[2]/$4; if (v>0 && v<1) print v}}'",
                     BIN_bcftools, shQuote(s), fmt, shQuote(vcf))
      out <- tryCatch(system2("/bin/sh", c("-c", cmd), stdout = TRUE), error = function(e) character())
      vafs <- suppressWarnings(as.numeric(out))
      if (length(vafs)) {
        het <- vafs[vafs >= 0.1 & vafs <= 0.9]
        vaf_rows[[length(vaf_rows) + 1]] <- tibble(
          Participant_id = pid, SampleID = s,
          n_het = length(het),
          median_VAF = suppressWarnings(median(het, na.rm = TRUE)),
          mixed_sample = length(het) >= 10
        )
        png(file.path(plot_dir, paste0("vaf_density_", s, ".png")), width = 1200, height = 800, res = 150)
        hist(vafs, breaks = 50, main = paste("VAF density:", s), xlab = "VAF", col = "grey70", border = "white")
        abline(v = c(0.1, 0.9), col = "red", lty = 2)
        dev.off()
      }
      progress_tick("E_VAF", pid, "sample_done")
    }
  }
  if (length(vaf_rows)) readr::write_csv(bind_rows(vaf_rows), vaf_csv)
  progress_tick("E_VAF", status = "done")
} else {
  msg("↪  Skipping E) VAF: bcftools not found.")
}

# ======================= F) PLASMID SEQUENCE TRACKING =========================
plasmid_clusters_csv <- file.path(base_out, "plasmids", "plasmid_clusters.csv")
plasmid_cn_csv       <- file.path(base_out, "plasmids", "plasmid_copy_number.csv")

plasmidfinder_long <- safe_read_csv("results/plasmidfinder_hits_long.csv")
if (!is.null(plasmidfinder_long) && ready$F) {
  msg("F) Plasmid-like contig clustering & copy-number estimation…"); progress_tick("F_PLS", status = "start")
  has_iso <- "Isolate_ID" %in% names(plasmidfinder_long)
  pl <- plasmidfinder_long %>%
    filter(!is.na(SEQUENCE)) %>%
    transmute(
      SampleID = if (has_iso) as.character(Isolate_ID) else NA_character_,
      contig   = SEQUENCE
    ) %>%
    filter(!is.na(SampleID))
  
  contig_fa_dir <- file.path(base_out, "plasmids", "contigs")
  dir.create(contig_fa_dir, recursive = TRUE, showWarnings = FALSE)
  contig_fastas <- list()
  for (i in seq_len(nrow(pl))) {
    sid <- pl$SampleID[i]; cont <- pl$contig[i]
    asm <- samples$assembly[samples$SampleID == sid][1]
    if (!file.exists(asm)) next
    outfa <- file.path(contig_fa_dir, paste0(sid, "_", gsub("[^A-Za-z0-9_.-]", "_", cont), ".fa"))
    if (!file.exists(outfa)) {
      cmd <- sprintf("awk '/^>/{p=($0~/%s/)} p' %s > %s", cont, shQuote(asm), shQuote(outfa))
      run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", paste0("extract_contig_", sid, ".log")), fail_ok = TRUE)
      if (!file.exists(outfa) || file.size(outfa) == 0) next
    }
    contig_fastas[[length(contig_fastas) + 1]] <- outfa
    progress_tick("F_PLS", sid, "contig")
  }
  contig_fastas <- unique(unlist(contig_fastas))
  
  if (length(contig_fastas) >= 2) {
    sk <- file.path(base_out, "plasmids", "contigs.msh")
    run_cmd(BIN_mash, c("sketch", "-p", opt$threads, "-o", shQuote(sk), paste(shQuote(contig_fastas), collapse = " ")),
            log_file = file.path(base_out, "logs", "mash_plasmid_sketch.log"), fail_ok = TRUE)
    dist_tab <- file.path(base_out, "plasmids", "contigs.dist")
    cmd <- sprintf("%s dist -p %d %s %s > %s", BIN_mash, opt$threads, shQuote(paste0(sk, ".msh")), shQuote(paste0(sk, ".msh")), shQuote(dist_tab))
    run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", "mash_plasmid_dist.log"), fail_ok = TRUE)
    if (file.exists(dist_tab)) {
      md <- suppressMessages(read_tsv(dist_tab, col_names = FALSE, show_col_types = FALSE))
      if (nrow(md)) {
        names(md) <- c("A","B","Mash","pval","shared")
        md <- md %>% mutate(A = basename(A), B = basename(B)) %>% filter(A != B)
        g <- graph_from_data_frame(md %>% filter(Mash < 0.05), directed = FALSE)
        cl <- components(g)
        clusters <- tibble(name = names(cl$membership), cluster = as.integer(cl$membership)) %>%
          mutate(SampleID = str_extract(name, "^[^_]+"))
        write_csv(clusters, plasmid_clusters_csv)
        progress_tick("F_PLS", status = "clustered")
        
        # Copy number scaffold (kept as NA unless mosdepth available)
        if (BIN_mosdepth != "") {
          cn_rows <- list()
          for (sid in unique(clusters$SampleID)) {
            bam <- file.path(base_out, "bam", samples$Participant_id[samples$SampleID == sid][1], paste0(sid, ".markdup.bam"))
            if (!file.exists(bam)) next
            prefix <- file.path(dirname(bam), paste0(basename(bam), ".contig"))
            run_cmd(BIN_mosdepth, c("-t", opt$threads, "--by", "1000", "--fast-mode", "-n", prefix, bam),
                    log_file = file.path(base_out, "logs", paste0("mosdepth_contig_", sid, ".log")), fail_ok = TRUE)
            chrom_depth <- NA_real_
            summ <- paste0(prefix, ".summary.txt")
            if (file.exists(summ)) {
              sm <- suppressMessages(read_tsv(summ, show_col_types = FALSE))
              chrom_depth <- median(sm$mean_coverage, na.rm = TRUE)
            }
            subc <- clusters %>% filter(SampleID == sid)
            if (!is.na(chrom_depth) && nrow(subc)) {
              cn_rows[[length(cn_rows) + 1]] <- subc %>% transmute(SampleID = sid, contig = name, cluster, copy_number = NA_real_)
            }
            progress_tick("F_PLS", sid, "cn_est")
          }
          if (length(cn_rows)) write_csv(bind_rows(cn_rows), plasmid_cn_csv)
        }
      }
    }
  }
  progress_tick("F_PLS", status = "done")
} else {
  msg("↪  Skipping F) Plasmid tracking: need plasmidfinder hits & mash.")
}

# =================== G) SAME-STRAIN PROBABILITY (MODEL) ======================
model_out_csv <- file.path(base_out, "model", "strain_probabilities.csv")
cal_plot <- file.path(plot_dir, "calibration_curve.png")
imp_plot <- file.path(plot_dir, "feature_importance.png")

feat_A <- if (exists("A_pairs") && nrow(A_pairs)) {
  A_pairs %>%
    transmute(
      A = SampleA,
      B = SampleB,
      SNPs_per_Mb = as.numeric(SNPs_per_Mb),
      callable_fraction = as.numeric(overlap_callable_bp / pmax(callable_A, callable_B, na.rm = TRUE))
    ) %>% distinct(A, B, .keep_all = TRUE)
} else {
  tibble(A = character(), B = character(), SNPs_per_Mb = numeric(), callable_fraction = numeric())
}

feat_B <- {
  tmp <- safe_read_csv(kmer_long_file)
  if (is.null(tmp)) tibble(A = character(), B = character(), Mash_distance = numeric())
  else tmp %>% select(A, B, Mash_distance) %>% distinct(A, B, .keep_all = TRUE)
}

feat_C <- {
  tmp <- safe_read_csv(pan_pairs_file)
  if (is.null(tmp)) tibble(A = character(), B = character(), Pan_Jaccard = numeric())
  else tmp %>% select(A, B, Pan_Jaccard) %>% distinct(A, B, .keep_all = TRUE)
}

feat_D <- {
  tmp <- safe_read_csv(sv_pairs_file)
  if (is.null(tmp)) tibble(A = character(), B = character(), SV_bp_total = numeric())
  else tmp %>% select(A, B, SV_bp_total) %>% distinct(A, B, .keep_all = TRUE)
}

st_map <- tibble(
  SampleID = samples$SampleID,
  ST = if ("ST" %in% names(samples)) as.character(samples$ST) else NA_character_
) %>% distinct(SampleID, .keep_all = TRUE)

feat_ST <- if (nrow(st_map) >= 2) {
  expand.grid(A = st_map$SampleID, B = st_map$SampleID, stringsAsFactors = FALSE) %>%
    filter(A < B) %>%
    left_join(st_map %>% rename(A = SampleID, ST_A = ST), by = "A", relationship = "many-to-one") %>%
    left_join(st_map %>% rename(B = SampleID, ST_B = ST), by = "B", relationship = "many-to-one") %>%
    mutate(ST_same = as.integer(nzchar(ST_A) & nzchar(ST_B) & ST_A == ST_B)) %>%
    select(A, B, ST_same) %>% distinct(A, B, .keep_all = TRUE)
} else {
  tibble(A = character(), B = character(), ST_same = integer())
}

feat <- list(feat_A, feat_B, feat_C, feat_D) %>%
  reduce(~ full_join(.x, .y, by = c("A","B"))) %>%
  left_join(feat_ST, by = c("A","B"), relationship = "many-to-one") %>%
  filter(A < B) %>% distinct(A, B, .keep_all = TRUE)

labels <- expand.grid(A = samples$SampleID, B = samples$SampleID, stringsAsFactors = FALSE) %>%
  filter(A < B) %>%
  left_join(samples %>% select(SampleID, Participant_id) %>% rename(PID_A = Participant_id), by = c("A" = "SampleID"), relationship = "many-to-one") %>%
  left_join(samples %>% select(SampleID, Participant_id) %>% rename(PID_B = Participant_id), by = c("B" = "SampleID"), relationship = "many-to-one") %>%
  mutate(label = as.integer(PID_A == PID_B)) %>%
  select(A, B, label) %>%
  distinct(A, B, .keep_all = TRUE)

dat <- feat %>% left_join(labels, by = c("A","B"), relationship = "many-to-one") %>%
  drop_na(label) %>% mutate(across(-c(A,B,label), ~ as.numeric(.x)))

if (nrow(dat) >= 20 && length(unique(dat$label)) == 2) {
  form <- label ~ SNPs_per_Mb + Mash_distance + Pan_Jaccard + SV_bp_total + ST_same + callable_fraction
  base_fit <- try(glm(form, family = binomial(), data = dat), silent = TRUE)
  if (!inherits(base_fit, "try-error")) {
    score <- as.numeric(predict(base_fit, type = "link"))
    dat$score <- score
    platt <- try(glm(label ~ score, family = binomial(), data = dat), silent = TRUE)
    if (!inherits(platt, "try-error")) {
      dat$P_same_strain <- as.numeric(predict(platt, type = "response"))
    } else {
      dat$P_same_strain <- as.numeric(predict(base_fit, type = "response"))
    }
    co <- coef(base_fit)
    imp <- tibble(feature = names(co)[-1], coef = as.numeric(co[-1])) %>%
      mutate(abs_coef = abs(coef)) %>% arrange(desc(abs_coef))
    write_csv(imp, file.path(base_out, "model", "feature_importance.csv"))
    write_csv(dat %>% select(A,B,P_same_strain, SNPs_per_Mb, Mash_distance, Pan_Jaccard, SV_bp_total, ST_same, callable_fraction),
              model_out_csv)
    cal <- dat %>% mutate(bin = cut(P_same_strain, breaks = seq(0,1,by=0.1), include.lowest = TRUE)) %>%
      group_by(bin) %>%
      summarise(pred = mean(P_same_strain), obs = mean(label), n = n(), .groups = "drop")
    p1 <- ggplot(cal, aes(pred, obs, size = n)) + geom_point() + geom_abline(linetype = 2) +
      labs(title = "Calibration curve", x = "Predicted", y = "Observed") + theme_minimal()
    write_plot(p1, cal_plot, 5, 4)
    p2 <- ggplot(imp, aes(reorder(feature, abs_coef), abs_coef)) + geom_col() + coord_flip() +
      labs(title = "Feature importance (|coef|)", x = NULL, y = "|Coefficient|")
    write_plot(p2, imp_plot, 6, 4)
  } else {
    msg("⚠️  Logistic model failed; skipping model outputs.")
  }
} else {
  msg("↪  Skipping G) Model: insufficient labeled pairs.")
}

# ==================== H) MASKS & DENOMINATORS COMPARISON ======================
masked_vs_unmasked_csv <- file.path(base_out, "masks", "distances_masked_vs_unmasked.csv")
masked_vs_plot <- file.path(plot_dir, "masked_unmasked_comparison.png")

comp_rows <- list()
for (pid in all_pids) {
  masked <- file.path(base_out, "core", paste0("core_alignment_", pid, ".fa"))
  unmasked <- file.path(base_out, "core", paste0("multi_", pid, ".fa"))
  if (file.exists(masked) && file.exists(unmasked) && BIN_snpdists != "") {
    ts1 <- tempfile(fileext = ".tsv")
    ts2 <- tempfile(fileext = ".tsv")
    run_cmd("/bin/sh", c("-c", sprintf("%s -c %s > %s", BIN_snpdists, shQuote(masked), shQuote(ts1))), fail_ok = TRUE)
    run_cmd("/bin/sh", c("-c", sprintf("%s -c %s > %s", BIN_snpdists, shQuote(unmasked), shQuote(ts2))), fail_ok = TRUE)
    d1 <- suppressMessages(read_tsv(ts1, show_col_types = FALSE))
    d2 <- suppressMessages(read_tsv(ts2, show_col_types = FALSE))
    if (nrow(d1) && nrow(d2)) {
      colnames(d1)[1] <- "Sample"; colnames(d2)[1] <- "Sample"
      l1 <- d1 %>% pivot_longer_safe(-Sample, names_to = "Sample2", values_to = "SNPs_masked") %>% filter(Sample < Sample2)
      l2 <- d2 %>% pivot_longer_safe(-Sample, names_to = "Sample2", values_to = "SNPs_unmasked") %>% filter(Sample < Sample2)
      comp <- l1 %>% left_join(l2, by = c("Sample","Sample2"), relationship = "many-to-one") %>%
        mutate(Participant_id = pid)
      comp_rows[[length(comp_rows)+1]] <- comp
      progress_tick("H_MASK", pid, "done")
    }
  }
}
if (length(comp_rows)) {
  mv <- bind_rows(comp_rows)
  write_csv(mv, masked_vs_unmasked_csv)
  p <- ggplot(mv, aes(SNPs_unmasked, SNPs_masked)) +
    geom_point(alpha = 0.6) + geom_abline(linetype = 2) +
    labs(title = "Masked vs unmasked SNP distances", x = "Unmasked", y = "Masked")
  write_plot(p, masked_vs_plot, 6, 5)
}

# ======================= I) ONE-PAGER REPORTS (PER PID) =======================
msg("I) One-pager reports per participant…"); progress_tick("I_REPORTS", status = "start")
vf_pa_all <- safe_read_csv("results/vf_pa_all.csv")

for (pid in all_pids) {
  core_pairs <- if (exists("A_pairs")) A_pairs %>% filter(Participant_id == pid) else tibble()
  sid_order <- samples %>% filter(Participant_id == pid) %>% arrange(tp_num) %>% pull(SampleID)
  
  p1 <- if (nrow(core_pairs)) {
    df <- core_pairs %>%
      filter(SampleA %in% sid_order, SampleB %in% sid_order) %>%
      mutate(idxA = match(SampleA, sid_order), idxB = match(SampleB, sid_order)) %>%
      filter(idxB == idxA + 1)
    if (nrow(df)) ggplot(df, aes(x = idxA, y = SNPs_per_Mb)) + geom_line() + geom_point() +
      scale_x_continuous(breaks = seq_along(sid_order), labels = sid_order) +
      labs(title = "Consecutive SNPs/Mb", x = "Sample (order)", y = "SNPs/Mb") else NULL
  } else NULL
  
  kd <- safe_read_csv(kmer_long_file)
  p2 <- if (!is.null(kd)) {
    df <- kd %>% filter(A %in% sid_order, B %in% sid_order) %>%
      mutate(iA = match(A, sid_order), iB = match(B, sid_order)) %>% filter(iB == iA + 1)
    if (nrow(df)) ggplot(df, aes(iA, Mash_distance)) + geom_line() + geom_point() +
      scale_x_continuous(breaks = seq_along(sid_order), labels = sid_order) +
      labs(title = "Consecutive Mash distance", x = "Sample (order)", y = "Mash distance") else NULL
  } else NULL
  
  pj <- safe_read_csv(pan_pairs_file)
  p3 <- if (!is.null(pj)) {
    df <- pj %>% filter(A %in% sid_order, B %in% sid_order) %>%
      mutate(iA = match(A, sid_order), iB = match(B, sid_order)) %>% filter(iB == iA + 1)
    if (nrow(df)) ggplot(df, aes(iA, Pan_Jaccard)) + geom_line() + geom_point() +
      scale_x_continuous(breaks = seq_along(sid_order), labels = sid_order) +
      labs(title = "Consecutive Pan-Jaccard", x = "Sample (order)", y = "Pan-Jaccard") else NULL
  } else NULL
  
  plc <- safe_read_csv(plasmid_clusters_csv)
  p4 <- if (!is.null(plc)) {
    df <- plc %>% filter(SampleID %in% sid_order)
    if (nrow(df)) ggplot(df, aes(x = factor(SampleID, levels = sid_order), y = as.factor(cluster))) +
      geom_point() + labs(title = "Plasmid clusters", x = "Sample", y = "Cluster") else NULL
  } else NULL
  
  # ---- FIXED: keep tp_lab and map to SampleID via a join, not indexing
  p5 <- NULL
  if (!is.null(vf_pa_all)) {
    # Make a mapping for this PID
    tp_map <- samples %>%
      filter(Participant_id == pid) %>%
      distinct(tp_lab, SampleID)
    if ("tp_lab" %in% names(vf_pa_all)) {
      sub <- vf_pa_all %>%
        filter(Participant_id == pid) %>%
        select(-Participant_id) %>%
        left_join(tp_map, by = "tp_lab") %>%           # <-- keep tp_lab and map to SampleID
        relocate(SampleID, .before = 1)
      if ("SampleID" %in% names(sub) && any(!is.na(sub$SampleID))) {
        sub <- sub %>% arrange(match(SampleID, sid_order))
        if (nrow(sub) >= 2) {
          gains <- losses <- c()
          for (i in 1:(nrow(sub) - 1)) {
            a <- as.numeric(sub[i, setdiff(names(sub), c("SampleID","tp_lab"))])
            b <- as.numeric(sub[i+1, setdiff(names(sub), c("SampleID","tp_lab"))])
            gains  <- c(gains,  sum((b == 1) & (a == 0), na.rm = TRUE))
            losses <- c(losses, sum((b == 0) & (a == 1), na.rm = TRUE))
          }
          df <- tibble(step = paste(sub$SampleID[-nrow(sub)], "→", sub$SampleID[-1]), gains = gains, losses = losses)
          dfl <- df %>% pivot_longer_safe(c(gains, losses), names_to = "type", values_to = "count")
          p5 <- ggplot(dfl, aes(step, count, fill = type)) + geom_col(position = "stack") + coord_flip() +
            labs(title = "VF gene changes", x = NULL, y = "Count")
        }
      }
    } else {
      msg("↪  VF table lacks 'tp_lab'; skipping VF plot for PID %s", pid)
    }
  }
  
  vaf <- safe_read_csv(vaf_csv)
  p6 <- if (!is.null(vaf)) {
    df <- vaf %>% filter(Participant_id == pid)
    if (nrow(df)) ggplot(df, aes(x = SampleID, y = n_het, fill = mixed_sample)) + geom_col() +
      coord_flip() + labs(title = "Heterozygous SNPs per sample", x = NULL, y = "# het sites") else NULL
  } else NULL
  
  plots <- purrr::compact(list(p1,p2,p3,p4,p5,p6))
  if (length(plots) > 0) {
    png(file.path(base_out, "reports", paste0("participant_report_", pid, ".png")), width = 1600, height = 1200, res = 150)
    do.call(grid.arrange, c(plots, nrow = 3, ncol = 2))
    dev.off()
  }
  progress_tick("I_REPORTS", pid, "done")
}
progress_tick("I_REPORTS", status = "done")
# ========================== J) SENSITIVITY / THRESHOLD SWEEP ===================
msg("J) Threshold sweeps & sensitivity…"); progress_tick("J_SENS", status = "start")
sens_dir <- file.path(base_out, "sensitivity")
dir.create(sens_dir, recursive = TRUE, showWarnings = FALSE)

# Features (present or NA)
af <- if (exists("A_pairs") && nrow(A_pairs)) {
  A_pairs %>% transmute(A=as.character(SampleA), B=as.character(SampleB),
                        SNPs_per_Mb = as.numeric(SNPs_per_Mb)) %>% distinct(A,B,.keep_all=TRUE)
} else tibble(A=character(),B=character(),SNPs_per_Mb=numeric())

kf <- { tmp <- safe_read_csv(kmer_long_file)
if (is.null(tmp)) tibble(A=character(),B=character(),Mash_distance=numeric())
else tmp %>% select(A,B,Mash_distance) %>% mutate(A=as.character(A),B=as.character(B)) %>%
  distinct(A,B,.keep_all=TRUE)
}

pf <- { tmp <- safe_read_csv(pan_pairs_file)
if (is.null(tmp)) tibble(A=character(),B=character(),Pan_Jaccard=numeric())
else tmp %>% select(A,B,Pan_Jaccard) %>% mutate(A=as.character(A),B=as.character(B)) %>%
  distinct(A,B,.keep_all=TRUE)
}

df_sv <- { tmp <- safe_read_csv(file.path(base_out,"sv","sv_pairs.csv"))
if (is.null(tmp)) tibble(A=character(),B=character(),SV_bp_total=numeric())
else tmp %>% select(A,B,SV_bp_total) %>% mutate(A=as.character(A),B=as.character(B)) %>%
  distinct(A,B,.keep_all=TRUE)
}

df <- list(af,kf,pf,df_sv) %>% reduce(~ full_join(.x,.y, by=c("A","B"))) %>% distinct(A,B,.keep_all=TRUE)

# Truth labels (within-PID)
labels <- expand.grid(A = samples$SampleID, B = samples$SampleID, stringsAsFactors = FALSE) %>%
  filter(A < B) %>%
  left_join(samples %>% select(SampleID, Participant_id) %>% rename(PID_A = Participant_id),
            by = c("A" = "SampleID"), relationship = "many-to-one") %>%
  left_join(samples %>% select(SampleID, Participant_id) %>% rename(PID_B = Participant_id),
            by = c("B" = "SampleID"), relationship = "many-to-one") %>%
  mutate(label = as.integer(PID_A == PID_B)) %>%
  select(A,B,label) %>% distinct(A,B,.keep_all=TRUE)

df <- df %>% left_join(labels, by = c("A","B"), relationship = "many-to-one")

# Model probabilities (if present)
mod <- safe_read_csv(file.path(base_out,"model","strain_probabilities.csv"))
if (!is.null(mod)) df <- df %>% left_join(mod %>% select(A,B,P_same_strain), by=c("A","B"))

metricify <- function(pred, truth) {
  pred <- as.integer(pred); truth <- as.integer(truth)
  keep <- !is.na(pred) & !is.na(truth)
  if (!any(keep)) return(tibble(TP=NA,FP=NA,TN=NA,FN=NA,acc=NA,prec=NA,rec=NA,f1=NA,n=0L))
  p <- pred[keep]; y <- truth[keep]
  TP <- sum(p==1 & y==1); FP <- sum(p==1 & y==0); TN <- sum(p==0 & y==0); FN <- sum(p==0 & y==1)
  acc <- (TP+TN)/length(p)
  prec <- if ((TP+FP)==0) NA_real_ else TP/(TP+FP)
  rec  <- if ((TP+FN)==0) NA_real_ else TP/(TP+FN)
  f1   <- if (is.na(prec) || is.na(rec) || (prec+rec)==0) NA_real_ else 2*prec*rec/(prec+rec)
  tibble(TP=TP,FP=FP,TN=TN,FN=FN,acc=acc,prec=prec,rec=rec,f1=f1,n=length(p))
}

sweep_one <- function(score, thresholds, direction = c("lower_better","higher_better"),
                      method_name, df, truth_col = "label") {
  direction <- match.arg(direction)
  rows <- vector("list", length(thresholds))
  for (i in seq_along(thresholds)) {
    t <- thresholds[i]
    pred <- if (direction=="lower_better") as.integer(df[[score]] <= t) else as.integer(df[[score]] >= t)
    rows[[i]] <- dplyr::bind_cols(tibble(method = method_name, threshold = t, metric = score),
                                  metricify(pred, df[[truth_col]]))
  }
  bind_rows(rows)
}

sweeps <- list()

if ("SNPs_per_Mb" %in% names(df) && any(!is.na(df$SNPs_per_Mb))) {
  thr <- sort(unique(c(seq(0,50,by=0.5), opt$snps_per_mb_max)))
  sweeps[["SNPs_per_Mb"]] <- sweep_one("SNPs_per_Mb", thr, "lower_better", "SNPs_per_Mb", df)
}

if ("Mash_distance" %in% names(df) && any(!is.na(df$Mash_distance))) {
  thr <- sort(unique(c(seq(0,0.1,by=0.001), opt$mash_max)))
  sweeps[["Mash_distance"]] <- sweep_one("Mash_distance", thr, "lower_better", "Mash_distance", df)
}

if ("Pan_Jaccard" %in% names(df) && any(!is.na(df$Pan_Jaccard))) {
  thr <- sort(unique(c(seq(0,0.3,by=0.005), opt$pan_jaccard_max)))
  sweeps[["Pan_Jaccard"]] <- sweep_one("Pan_Jaccard", thr, "lower_better", "Pan_Jaccard", df)
}

if ("SV_bp_total" %in% names(df) && any(!is.na(df$SV_bp_total))) {
  qs <- stats::quantile(df$SV_bp_total, probs = seq(0,1,by=0.02), na.rm = TRUE)
  thr <- sort(unique(c(0, as.numeric(qs))))
  sweeps[["SV_bp_total"]] <- sweep_one("SV_bp_total", thr, "lower_better", "SV_bp_total", df)
}

if ("P_same_strain" %in% names(df) && any(!is.na(df$P_same_strain))) {
  thr <- seq(0,1,by=0.01)
  sweeps[["P_same_strain"]] <- sweep_one("P_same_strain", thr, "higher_better", "P_same_strain", df)
}

if (length(sweeps)) {
  sweep_tbl <- bind_rows(sweeps)
  readr::write_csv(sweep_tbl, file.path(sens_dir, "threshold_sweep.csv"))
  best_tbl <- sweep_tbl %>% group_by(method) %>%
    slice_max(order_by = f1, n = 1, with_ties = FALSE) %>% ungroup()
  readr::write_csv(best_tbl, file.path(sens_dir, "best_thresholds.csv"))
  p <- ggplot(sweep_tbl, aes(threshold, f1, group = 1)) +  # <- add group=1
    geom_line() +
    facet_wrap(~method, scales = "free_x") +
    labs(title = "F1 vs threshold by method", x = "Threshold", y = "F1") +
    theme_minimal()
  write_plot(p, file.path(plot_dir, "sensitivity_f1_curves.png"), 9, 6)
} else {
  msg("↪  J) No features available for sweeping; skipping.")
}
progress_tick("J_SENS", status = "done")
# ============================= K) POST-PROCESSING ==============================
msg("K) Post-processing exports…"); progress_tick("K_POST", status = "start")

rep_dir <- file.path(base_out, "reports")
dir.create(rep_dir, recursive = TRUE, showWarnings = FALSE)

# Rebuild 'df' if needed, then decorate with labels and TP deltas
if (!exists("df")) {
  af <- if (exists("A_pairs") && nrow(A_pairs)) {
    A_pairs %>% transmute(A = as.character(SampleA),
                          B = as.character(SampleB),
                          SNPs_per_Mb = as.numeric(SNPs_per_Mb)) %>%
      distinct(A, B, .keep_all = TRUE)
  } else tibble(A = character(), B = character(), SNPs_per_Mb = numeric())
  
  kf <- {
    tmp <- safe_read_csv(kmer_long_file)
    if (is.null(tmp)) tibble(A = character(), B = character(), Mash_distance = numeric())
    else tmp %>% select(A, B, Mash_distance) %>%
      mutate(A = as.character(A), B = as.character(B)) %>%
      distinct(A, B, .keep_all = TRUE)
  }
  
  pf <- {
    tmp <- safe_read_csv(pan_pairs_file)
    if (is.null(tmp)) tibble(A = character(), B = character(), Pan_Jaccard = numeric())
    else tmp %>% select(A, B, Pan_Jaccard) %>%
      mutate(A = as.character(A), B = as.character(B)) %>%
      distinct(A, B, .keep_all = TRUE)
  }
  
  df_sv <- {
    tmp <- safe_read_csv(file.path(base_out, "sv", "sv_pairs.csv"))
    if (is.null(tmp)) tibble(A = character(), B = character(), SV_bp_total = numeric())
    else tmp %>% select(A, B, SV_bp_total) %>%
      mutate(A = as.character(A), B = as.character(B)) %>%
      distinct(A, B, .keep_all = TRUE)
  }
  # Null-safe inputs
  vaf <- safe_read_csv(file.path(base_out, "vaf", "het_snp_summary.csv"))
  if (is.null(vaf)) {
    vaf <- tibble(SampleID=character(), n_het=integer(),
                  median_VAF=as.numeric(NA), mixed_sample=logical())
  }
  
  plc <- safe_read_csv(file.path(base_out, "plasmids", "plasmid_clusters.csv"))
  if (is.null(plc)) {
    plc <- tibble(SampleID=character(), cluster=integer())
  }
  plc_by_sample <- plc %>%
    group_by(SampleID) %>%
    summarise(n_plasmid_clusters = dplyr::n_distinct(cluster), .groups="drop")
  
  sample_summary <- samples %>%
    select(SampleID, Participant_id, tp_lab, tp_num, ST, n_contigs, n50, total_bp) %>%
    mutate(across(c(SampleID, Participant_id, tp_lab), as.character)) %>%
    left_join(vaf %>% select(SampleID, n_het, median_VAF, mixed_sample),
              by = "SampleID", relationship = "many-to-one") %>%
    left_join(plc_by_sample, by = "SampleID", relationship = "many-to-one")
  
  readr::write_csv(sample_summary, file.path(rep_dir, "sample_summary.csv"))
  df <- list(af, kf, pf, df_sv) %>%
    reduce(~ full_join(.x, .y, by = c("A","B"))) %>%
    distinct(A, B, .keep_all = TRUE)
  
  labels <- expand.grid(A = samples$SampleID, B = samples$SampleID, stringsAsFactors = FALSE) %>%
    filter(A < B) %>%
    left_join(samples %>% select(SampleID, Participant_id) %>% rename(PID_A = Participant_id),
              by = c("A" = "SampleID"), relationship = "many-to-one") %>%
    left_join(samples %>% select(SampleID, Participant_id) %>% rename(PID_B = Participant_id),
              by = c("B" = "SampleID"), relationship = "many-to-one") %>%
    mutate(label = as.integer(PID_A == PID_B)) %>%
    select(A, B, label) %>%
    distinct(A, B, .keep_all = TRUE)
  
  df <- df %>% left_join(labels, by = c("A","B"), relationship = "many-to-one")
  
  mod <- safe_read_csv(file.path(base_out, "model", "strain_probabilities.csv"))
  if (!is.null(mod)) df <- df %>% left_join(mod %>% select(A, B, P_same_strain), by = c("A","B"))
}

# Map timepoints, compute |ΔTP|
tp_map <- samples %>% select(SampleID, Participant_id, tp_num) %>%
  mutate(SampleID = as.character(SampleID), Participant_id = as.character(Participant_id))

df <- df %>%
  left_join(tp_map %>% rename(PID_A = Participant_id, tp_A = tp_num), by = c("A" = "SampleID")) %>%
  left_join(tp_map %>% rename(PID_B = Participant_id, tp_B = tp_num), by = c("B" = "SampleID")) %>%
  mutate(delta_tp = ifelse(!is.na(tp_A) & !is.na(tp_B), abs(tp_A - tp_B), NA_integer_))

# Heuristic calls with CLI defaults
df <- df %>%
  mutate(
    call_SNPs = ifelse(!is.na(SNPs_per_Mb), SNPs_per_Mb <= opt$snps_per_mb_max, NA),
    call_Mash = ifelse(!is.na(Mash_distance), Mash_distance <= opt$mash_max, NA),
    call_Pan  = ifelse(!is.na(Pan_Jaccard),  Pan_Jaccard  <= opt$pan_jaccard_max, NA)
  )

# Threshold for SV (use best sweep if present; else lower quartile)
best_thr <- NA_real_
best_tbl_path <- file.path(base_out, "sensitivity", "best_thresholds.csv")
if (file.exists(best_tbl_path)) {
  bt <- suppressMessages(readr::read_csv(best_tbl_path, show_col_types = FALSE))
  if (nrow(bt) && any(bt$method == "SV_bp_total")) {
    best_thr <- bt$threshold[bt$method == "SV_bp_total"][1]
  }
}
if (is.na(best_thr) && "SV_bp_total" %in% names(df) && any(!is.na(df$SV_bp_total))) {
  best_thr <- as.numeric(stats::quantile(df$SV_bp_total, 0.25, na.rm = TRUE))
}
df <- df %>% mutate(call_SV = ifelse(!is.na(SV_bp_total) & !is.na(best_thr), SV_bp_total <= best_thr, NA))

# Model call (prefer calibrated threshold if available)
best_model_thr <- NA_real_
if (file.exists(best_tbl_path)) {
  bt <- suppressMessages(readr::read_csv(best_tbl_path, show_col_types = FALSE))
  if (nrow(bt) && any(bt$method == "P_same_strain")) {
    best_model_thr <- bt$threshold[bt$method == "P_same_strain"][1]
  }
}
if (is.na(best_model_thr)) best_model_thr <- 0.5

# Ensure the model column exists even if the model stage was skipped
if (!"P_same_strain" %in% names(df)) df <- df %>% mutate(P_same_strain = NA_real_)

df <- df %>% mutate(call_Model = ifelse(!is.na(P_same_strain), P_same_strain >= best_model_thr, NA))

# Recommended call (includes SV as a fallback)
df <- df %>% mutate(call_recommended = dplyr::coalesce(call_Model, call_SNPs, call_Mash, call_Pan, call_SV))

# Pairwise master export
pair_master <- df %>%
  transmute(
    A, B,
    PID_A, PID_B, delta_tp,
    SNPs_per_Mb, Mash_distance, Pan_Jaccard, SV_bp_total, P_same_strain,
    call_SNPs, call_Mash, call_Pan, call_SV, call_Model, call_recommended,
    truth_within_pid = label
  ) %>% arrange(A, B)

readr::write_csv(pair_master, file.path(rep_dir, "pairwise_master.csv"))

# --------------------- Sample-level summary (NULL-safe) ------------------------
vaf <- safe_read_csv(file.path(base_out, "vaf", "het_snp_summary.csv"))
plc <- safe_read_csv(file.path(base_out, "plasmids", "plasmid_clusters.csv"))

vaf_tbl <- if (!is.null(vaf) && "SampleID" %in% names(vaf)) {
  vaf %>% dplyr::select(SampleID, n_het, median_VAF, mixed_sample)
} else {
  tibble::tibble(
    SampleID = character(),
    n_het = integer(),
    median_VAF = numeric(),
    mixed_sample = logical()
  )
}

plc_tbl <- if (!is.null(plc) && all(c("SampleID","cluster") %in% names(plc))) {
  plc %>%
    dplyr::group_by(SampleID) %>%
    dplyr::summarise(n_plasmid_clusters = dplyr::n_distinct(cluster), .groups = "drop")
} else {
  tibble::tibble(SampleID = character(), n_plasmid_clusters = integer())
}

sample_summary <- samples %>%
  dplyr::select(SampleID, Participant_id, tp_lab, tp_num, ST, n_contigs, n50, total_bp) %>%
  dplyr::mutate(across(c(SampleID, Participant_id, tp_lab), as.character)) %>%
  dplyr::left_join(vaf_tbl, by = "SampleID", relationship = "many-to-one") %>%
  dplyr::left_join(plc_tbl, by = "SampleID", relationship = "many-to-one")

readr::write_csv(sample_summary, file.path(rep_dir, "sample_summary.csv"))

progress_tick("K_POST", status = "done")
msg("✅ Pipeline complete (with skips as noted). See results/plots/_progress.png for a live heartbeat.")
