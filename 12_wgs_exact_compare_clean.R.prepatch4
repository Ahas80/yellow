              help = "Comma-separated participant IDs to restrict; default ALL"),
  make_option("--mode", type = "character", default = "auto",
              help = "auto|reads|assemblies (prefer reads if present in auto)"),
  make_option("--min_depth", type = "integer", default = 10,
              help = "Minimum depth for callable positions (default 10)"),
  make_option("--min_qual", type = "integer", default = 20,
              help = "Minimum base/variant quality (default 20)"),
  make_option("--snps_per_mb_max", type = "double", default = 20,
