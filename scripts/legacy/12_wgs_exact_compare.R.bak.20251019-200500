      mutate(SampleID = as.character(SampleID)) %>%
      left_join(mm, by = "SampleID", relationship = "many-to-one") %>%
      mutate(
        Participant_id = dplyr::coalesce(Participant_id.y, Participant_id.x),
        Timepoint      = dplyr::coalesce(Timepoint.y, Timepoint.x),
        ST             = dplyr::coalesce(ST, NA_character_)
