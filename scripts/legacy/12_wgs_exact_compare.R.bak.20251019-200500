prefer_reads <- function(s) {
  if (opt$mode == "reads") return(TRUE)
  if (opt$mode == "assemblies") return(FALSE)
  !is.na(s$R1) & !is.na(s$R2) & file.exists(s$R1) & file.exists(s$R2)
}


# ============================== A) CORE SNPs ==================================
A_results <- list()
if (ready$A) {
  msg("A) CORE SNP analysis starting…"); progress_tick("A_CORE", status = "start")
  bam_dir <- file.path(base_out, "bam")
  dir.create(bam_dir, recursive = TRUE, showWarnings = FALSE)
  
  pick_ref_for_pid <- function(df_pid) {
    dfp <- df_pid %>%
      filter(!is.na(assembly) & file.exists(assembly)) %>%
      arrange(is.na(tp_num), tp_num, desc(n50), desc(total_bp))
    if (nrow(dfp) == 0) return(tibble(ref_fa = NA_character_, ref_sample = NA_character_))
    tibble(ref_fa = dfp$assembly[1], ref_sample = dfp$SampleID[1])
  }
  
  make_bam_for_sample <- function(ref_fa, srow) {
    s <- srow[1, ]
    out_bam <- file.path(bam_dir, s$Participant_id, paste0(s$SampleID, ".markdup.bam"))
    out_bai <- paste0(out_bam, ".bai")
    dir.create(dirname(out_bam), recursive = TRUE, showWarnings = FALSE)
    
    # already done?
    if (file.exists(out_bam) && file.exists(out_bai)) return(out_bam)
    
    sam_sort <- file.path(bam_dir, s$Participant_id, paste0(s$SampleID, ".sorted.bam"))
    
    # Build minimap2 args once
    rg <- sprintf("@RG\\tID:%s\\tSM:%s", s$SampleID, s$SampleID)
    if (prefer_reads(s)) {
      if (is.na(s$R1) || is.na(s$R2) || !file.exists(s$R1) || !file.exists(s$R2)) return(NA_character_)
      mm2_args <- c("-t", as.character(opt$threads),
                    "-ax", "sr",
                    "-R", rg,
                    ref_fa, s$R1, s$R2)
    } else {
      if (is.na(s$assembly) || !file.exists(s$assembly)) return(NA_character_)
      mm2_args <- c("-t", as.character(opt$threads),
                    "-ax", "asm10",
                    ref_fa, s$assembly)
    }
    
    pipe_cmd <- sprintf(
      "%s %s | %s sort -@ %d -O BAM -o %s -",
      shQuote(BIN_minimap2),
      paste(vapply(mm2_args, shQuote, character(1)), collapse = " "),
      shQuote(BIN_samtools),
      as.integer(opt$threads),
      shQuote(sam_sort)
    )
    
    run_cmd(
      "/bin/bash",
      c("-c", sprintf("set -o pipefail; %s", pipe_cmd)),
      log_file = file.path(base_out, "logs", paste0("map_sort_", s$SampleID, ".log")),
      echo = TRUE,
      fail_ok = FALSE
    )
    
    if (!file.exists(sam_sort) || file.size(sam_sort) == 0) return(NA_character_)
    
    # markdup
    run_cmd(BIN_samtools, c("markdup", "-@", as.character(opt$threads), "-s", sam_sort, out_bam), fail_ok = FALSE)
    
    # ensure RG:SM == SampleID
    tmp_bam <- paste0(out_bam, ".rg.bam")
    run_cmd(BIN_samtools, c("addreplacerg", "-r", rg, "-o", tmp_bam, out_bam), fail_ok = FALSE)
    file.rename(tmp_bam, out_bam)
    
    run_cmd(BIN_samtools, c("index", out_bam), fail_ok = FALSE)
    unlink(sam_sort)
    
    if (file.exists(out_bam) && file.exists(out_bai)) out_bam else NA_character_
  }    

  
  callable_bp_mosdepth <- function(bam, min_depth = opt$min_depth) {
    if (BIN_mosdepth == "") return(NA_real_)
    prefix <- file.path(dirname(bam), paste0(basename(bam), ".mosdepth"))
    if (!file.exists(paste0(prefix, ".global.dist.txt"))) {
      run_cmd(BIN_mosdepth, c("-t", as.character(opt$threads), "--no-per-base", "--fast-mode", "-n", prefix, bam),
              log_file = file.path(base_out, "logs", paste0("mosdepth_", basename(bam), ".log")), fail_ok = TRUE)
    }
    p <- paste0(prefix, ".global.dist.txt")
    if (!file.exists(p)) return(NA_real_)
    df <- tryCatch(read_tsv(p, col_names = c("chrom","depth","count"), show_col_types = FALSE), error = function(e) NULL)
    if (is.null(df)) return(NA_real_)
    df %>% filter(depth >= min_depth) %>% summarise(sum = sum(count, na.rm = TRUE)) %>% pull(sum) %>% as.numeric()
  }
  
  # plan disabled by patch)
  # on.exit(plan) disabled by patch
  
  A_results <- safe_future_lapply(all_pids, function(pid) {
    df_pid <- samples %>% filter(Participant_id == pid)
    if (!nrow(df_pid)) return(NULL)
    ref <- pick_ref_for_pid(df_pid)
    ref_fa <- ref$ref_fa; ref_sample <- ref$ref_sample
    if (is.na(ref_fa) || !file.exists(ref_fa)) {
      msg("↪  PID %s: no usable assembly reference; skipping core SNPs.", pid)
      progress_tick("A_CORE", pid, "no_ref")
      return(NULL)
    }
    msg("PID %s: reference=%s (%s)", pid, basename(ref_fa), ref_sample)
    
    # BAMs
    # BAMs — make one per SampleID and keep names
    bams <- lapply(split(df_pid, df_pid$SampleID),
                   function(s) make_bam_for_sample(ref_fa, s))
    bam_vec <- unlist(bams, use.names = TRUE)                 # names = SampleID
    bam_vec <- bam_vec[!is.na(bam_vec) & file.exists(bam_vec)]
    
    bam_list_file <- file.path(base_out, "core", paste0("bam_list_", pid, ".txt"))
    vcf_out <- file.path(base_out, "core", paste0("joint_", pid, ".vcf.gz"))

    if (!length(bam_vec)) {
      msg("↪  PID %s: no usable BAMs; skipping core SNPs.", pid)
      progress_tick("A_CORE", pid, "no_bams")
      return(NULL)
    }
    writeLines(unname(bam_vec), bam_list_file)                # list file = paths only
    
    tbi <- paste0(vcf_out, ".tbi")
    
    # treat BAMs + reference as inputs that can stale the joint VCF
    inputs <- c(unname(bam_vec), ref_fa)
    inputs <- inputs[file.exists(inputs)]
    
    needs_rebuild <-
      opt$force ||
      !file.exists(vcf_out) || !file.exists(tbi) ||
      file.info(vcf_out)$size == 0 ||
      (length(inputs) > 0 && any(file.mtime(inputs) > file.mtime(vcf_out), na.rm = TRUE))
    
    if (needs_rebuild) {
      unlink(c(vcf_out, tbi), force = TRUE)
      tmp <- paste0(vcf_out, ".tmp.", Sys.getpid())
      
      mp <- sprintf("%s mpileup -f %s -a AD,DP -q %d -Q %d -Ou -b %s",
                    shQuote(BIN_bcftools),
                    shQuote(ref_fa),
                    0L, as.integer(opt$min_qual),
                    shQuote(bam_list_file))
      cl <- sprintf("%s call -m --ploidy 1 -Oz -o %s", shQuote(BIN_bcftools), shQuote(tmp))
      full <- sprintf("set -o pipefail; %s | %s", mp, cl)
      
      logf <- file.path(base_out, "logs", paste0("bcf_call_", pid, ".log"))
      run_cmd("/bin/bash", c("-lc", full), log_file = logf, fail_ok = FALSE)
      
      if (!file.exists(tmp) || file.size(tmp) == 0)
        stop(sprintf("bcftools mpileup/call failed for PID %s. See %s", pid, logf))
      
      run_cmd(BIN_bcftools, c("index", "-t", tmp), fail_ok = FALSE)
      
      # atomic move into place
      file.rename(tmp, vcf_out)
      file.rename(paste0(tmp, ".tbi"), tbi)
    } else {
      msg("[core] joint_%s.vcf.gz up to date; skipping.", pid)
    }
    

    

    # Ensure FASTA index for the reference used by mpileup
    if (!file.exists(paste0(ref_fa, ".fai"))) {
      run_cmd(BIN_samtools, c("faidx", ref_fa), fail_ok = FALSE)
    }
    
    # map VCF sample names (from BAM filenames) back to bare SampleID
    smps_in_vcf <- system2(BIN_bcftools, c("query","-l", vcf_out), stdout = TRUE)
    if (length(smps_in_vcf) == 0) stop(sprintf("Joint VCF has 0 samples for PID %s", pid))
    
    # primary mapping: strip trailing .markdup.bam -> SampleID
    vcf_name_map <- setNames(smps_in_vcf, sub("\\.markdup\\.bam$", "", basename(smps_in_vcf)))
    
    # fallback if names collide or don't match:
    if (anyNA(vcf_name_map) || length(unique(names(vcf_name_map))) != length(vcf_name_map)) {
      alt_keys <- sub("\\.bam$", "", basename(smps_in_vcf))
      vcf_name_map <- setNames(smps_in_vcf, alt_keys)
    }
    
    # Consensus per sample
    cons_dir <- file.path(base_out, "core", paste0("consensus_", pid))
    dir.create(cons_dir, showWarnings = FALSE, recursive = TRUE)
    cons_fastas <- c()
    for (sid in df_pid$SampleID) {
