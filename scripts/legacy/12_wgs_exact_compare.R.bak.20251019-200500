if (ready$D) {
  msg("D) SV summary via nucmer/show-diff…"); progress_tick("D_SV", status = "start")
  sv_rows <- list()
  for (pid in all_pids) {
    dfp <- samples %>% filter(Participant_id == pid)
    if (nrow(dfp) < 2) next
    comb <- t(combn(dfp$SampleID, 2))
    for (i in seq_len(nrow(comb))) {
      a <- comb[i, 1]; b <- comb[i, 2]
      fa <- dfp$assembly[dfp$SampleID == a][1]
      fb <- dfp$assembly[dfp$SampleID == b][1]
      if (!file.exists(fa) || !file.exists(fb)) {
        progress_tick("D_SV", pid, "missing_assembly")
        next
      }
      outdir <- file.path(base_out, "sv", paste0(pid, "_", a, "_vs_", b))
      dir.create(outdir, recursive = TRUE, showWarnings = FALSE)
      pref <- file.path(outdir, "run")
      run_cmd(BIN_nucmer, c("--mum", "--prefix", pref, fa, fb),
              log_file = file.path(base_out, "logs", paste0("nucmer_sv_", pid, "_", a, "_", b, ".log")), fail_ok = TRUE)
      delta <- paste0(pref, ".delta")
      if (!file.exists(delta)) { progress_tick("D_SV", pid, "nucmer_failed"); next }
      
      ### >>> PATCH 2: show-diff invocation + fallback
      diff_file <- file.path(outdir, "showdiff.txt")
      
      # Try show-diff with separate flags (MUMmer3 style)
      cmd1 <- sprintf("%s -q -r -s %s > %s",
                      shQuote(BIN_showdiff), shQuote(delta), shQuote(diff_file))
      run_cmd("/bin/sh", c("-c", cmd1),
              log_file = file.path(base_out, "logs", paste0("showdiff_", pid, "_", a, "_", b, ".log")),
              fail_ok = TRUE)
      
      # If it's empty, fall back to show-coords so we still get a signal
      if (!file.exists(diff_file) || file.size(diff_file) == 0) {
        coords <- file.path(outdir, "coords.tsv")
        cmd2 <- sprintf("%s -TrH %s > %s",  # tabular, report ranges, no header
                        shQuote(BIN_showcoords), shQuote(delta), shQuote(coords))
        run_cmd("/bin/sh", c("-c", cmd2),
                log_file = file.path(base_out, "logs", paste0("showcoords_", pid, "_", a, "_", b, ".log")),
                fail_ok = TRUE)
        # very light-weight proxy: count orientation flips as inversions
        if (file.exists(coords) && file.size(coords) > 0) {
          co <- suppressMessages(readr::read_tsv(coords, show_col_types = FALSE, col_names = FALSE))
          inv <- 0L
          if (nrow(co) >= 2) {
            # columns 9/10 in -TrH are ref/qry orientation (+/-)
            ori_r <- as.character(co[[9]]); ori_q <- as.character(co[[10]])
            flips <- sum((ori_r[-1] != ori_r[-nrow(co)]) | (ori_q[-1] != ori_q[-nrow(co)]), na.rm = TRUE)
            inv <- as.integer(flips)
          }
          # keep diff_file empty; we just set 'inv' downstream
          types <- NULL; lens <- NULL
        }
      }
      ### <<< PATCH 2      
      ins <- del <- inv <- trans <- 0L
      ins_bp <- del_bp <- inv_bp <- trans_bp <- 0
      if (file.exists(diff_file)) {
        df <- suppressWarnings(read_tsv(diff_file, col_names = FALSE, show_col_types = FALSE))
        if (nrow(df)) {
          type_col <- which(sapply(df, function(c) all(nchar(unique(na.omit(c))) <= 2)))
          if (length(type_col)) {
            tcol <- type_col[1]
            num_cols <- which(sapply(df, function(x) all(grepl("^\\d+$", as.character(x)))))
            lcol <- if (length(num_cols)) num_cols[length(num_cols)] else NA_integer_
            types <- df[[tcol]]
            lens  <- if (!is.na(lcol)) as.numeric(df[[lcol]]) else rep(1, nrow(df))
            ins   <- sum(types == "I", na.rm = TRUE); del <- sum(types == "D", na.rm = TRUE)
            inv   <- sum(types == "R", na.rm = TRUE); trans <- sum(types == "T", na.rm = TRUE)
            ins_bp <- sum(lens[types == "I"], na.rm = TRUE)
            del_bp <- sum(lens[types == "D"], na.rm = TRUE)
            inv_bp <- sum(lens[types == "R"], na.rm = TRUE)
            trans_bp <- sum(lens[types == "T"], na.rm = TRUE)
          }
        }
      }
      sv_rows[[length(sv_rows) + 1]] <- tibble(
        Participant_id = as.character(pid),
        A = as.character(a),
        B = as.character(b),
        insertions = as.integer(ins),
        deletions = as.integer(del),
        inversions = as.integer(inv),
        translocations = as.integer(trans),
        ins_bp = as.numeric(ins_bp),
        del_bp = as.numeric(del_bp),
        inv_bp = as.numeric(inv_bp),
        trans_bp = as.numeric(trans_bp),
        SV_bp_total = as.numeric(sum(ins_bp, del_bp, inv_bp, trans_bp, na.rm = TRUE))
      )
      progress_tick("D_SV", pid, "pair_done")
    }
  }
  if (length(sv_rows)) {
    sv_pairs <- bind_rows(sv_rows) %>% distinct(A, B, .keep_all = TRUE)
    write_csv(sv_pairs, sv_pairs_file)
    
    pair11 <- safe_read_csv("results/within_person/pairwise_summary.csv")
    if (!is.null(pair11)) {
      anicol <- intersect(c("ani","ANI","nucmer_ANI"), names(pair11))
      if (length(anicol)) {
        j <- pair11 %>% rename(A = 1, B = 2) %>% rename(ANI = !!anicol[1]) %>% mutate(A = as.character(A), B = as.character(B))
        dfp <- sv_pairs %>% left_join(j, by = c("A","B"))
        p <- ggplot(dfp, aes(ANI, SV_bp_total)) + geom_point(alpha = 0.6) +
          labs(title = "SV bp total vs ANI", x = "ANI", y = "SV total bp") + theme_minimal()
        write_plot(p, sv_plot_file, 6, 5)
      }
    }
  }
  progress_tick("D_SV", status = "done")
} else {
  msg("↪  Skipping D) SV: need nucmer + show-diff/coords.")
}

# ================== E) WITHIN-TIMEPOINT SUBCLONE SIGNAL (VAF) =================
vaf_csv <- file.path(base_out, "vaf", "het_snp_summary.csv")

if (ready$E) {
  # --- E) VAF / heterozygous site summary (fixed) ---
  msg("E) VAF / heterozygous site summary…"); progress_tick("E_VAF", status = "start")
  vaf_rows <- list()
  joint_vcfs <- list.files(file.path(base_out, "core"), pattern = "^joint_.*\\.vcf\\.gz$", full.names = TRUE)
  
  for (vcf in joint_vcfs) {
    pid <- stringr::str_match(basename(vcf), "^joint_(.*)\\.vcf\\.gz$")[,2]
    smps <- system2(BIN_bcftools, c("query", "-l", vcf), stdout = TRUE)
    for (s in smps) {
      # Safe format: colon-delimited, no newline
      fmt <- "[%AD:%DP]"
      raw <- suppressWarnings(
        system2(BIN_bcftools, c("query", "-s", s, "-f", fmt, vcf),
                stdout = TRUE, stderr = FALSE)   # discard usage spam on error
      )
      
      if (length(raw) == 0) next
      
      # Split the AD:DP pairs
      pieces <- strsplit(raw, ":", fixed = TRUE)
      
      # First field is AD (e.g., "12,3" or "10,2,0" for multiallelic)
      ad_str <- vapply(pieces, function(x) if (length(x) >= 1) x[[1]] else "", "")
      dp     <- suppressWarnings(as.numeric(vapply(pieces, function(x) if (length(x) >= 2) x[[2]] else NA_character_, "")))
      
      # Keep biallelic-style entries with numeric DP
      keep <- !is.na(dp) & dp > 0 & nzchar(ad_str) & ad_str != "." & grepl(",", ad_str, fixed = TRUE)
      
      if (any(keep)) {
        # Pull the first ALT count from AD (ref,alt[,alt2...]); use the first ALT for VAF
        alt <- suppressWarnings(as.numeric(sub("^[^,]*,([^,]+).*", "\\1", ad_str[keep])))
        vafs <- alt / dp[keep]
        
        if (length(vafs)) {
          het <- vafs[vafs > 0 & vafs < 1]
          vaf_rows[[length(vaf_rows) + 1]] <- tibble(
            Participant_id = pid, SampleID = s,
            n_het = length(het),
            median_VAF = suppressWarnings(median(het, na.rm = TRUE)),
            mixed_sample = length(het) >= 10
          )
          png(file.path(plot_dir, paste0("vaf_density_", s, ".png")), width = 1200, height = 800, res = 150)
          hist(vafs, breaks = 50, main = paste("VAF density:", s), xlab = "VAF", col = "grey70", border = "white")
          abline(v = c(0.1, 0.9), col = "red", lty = 2)
          dev.off()
        }
      }
    }
  if (length(vaf_rows)) readr::write_csv(dplyr::bind_rows(vaf_rows), file.path(base_out, "vaf", "het_snp_summary.csv"))
  progress_tick("E_VAF", status = "done")
} else {
  msg("↪  Skipping E) VAF: bcftools not found.")
}

