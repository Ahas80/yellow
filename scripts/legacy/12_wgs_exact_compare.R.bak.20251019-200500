check_bin <- function(bin_candidates) {
  # Prefer explicit yellow-wgs paths if present, then PATH
  cand <- unique(c(
    file.path(Sys.getenv("CONDA_PREFIX"), "bin", bin_candidates),
    bin_candidates
  ))
  hits <- Sys.which(cand)
  p <- hits[hits != ""]
  if (length(p)) return(unname(p[1]))
  ""
}

