  }
  
  # keep this line (already in your script)
  all_dist <- file.path(base_out, "kmer", "mash_all_vs_all.tab")
  
  # new: only run Mash if at least two sketches exist
  existing_msh <- Filter(file.exists, msh_files)
  if (length(existing_msh) >= 2) {
    combined <- file.path(sk_dir, "combined")
    cmd <- sprintf("%s paste %s %s",
                   shQuote(BIN_mash),
                   shQuote(combined),
