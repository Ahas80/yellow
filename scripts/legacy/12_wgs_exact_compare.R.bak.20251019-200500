              fail_ok = TRUE)
    }
    
    if (file.exists(outfa) && file.size(outfa) >= 100) {
      contig_fastas[[length(contig_fastas) + 1]] <- outfa
      progress_tick("F_PLS", sid, "contig")
    }
  }
  contig_fastas <- unique(unlist(contig_fastas))
  
  if (length(contig_fastas) >= 2) {
    sk_base <- file.path(base_out, "plasmids", "contigs_sketch")
    cmd <- sprintf("%s sketch -p %d -o %s %s",
                   shQuote(BIN_mash), opt$threads, shQuote(sk_base),
                   paste(shQuote(contig_fastas), collapse = " "))
    run_cmd("/bin/sh", c("-c", cmd),
            log_file = file.path(base_out, "logs", "mash_plasmid_sketch.log"), fail_ok = TRUE)
    
    dist_tab <- file.path(base_out, "plasmids", "contigs_sketch.dist")

    
    ### <<< PATCH 3A
    # --- NEW: build clusters from Mash distances and write CSV ---
    clusters <- tibble::tibble()
    if (file.exists(dist_tab)) {
      md <- tryCatch(parse_mash(dist_tab), error = function(e) NULL)
      if (!is.null(md) && nrow(md) > 0) {
        md <- md %>%
          dplyr::transmute(A = basename(A), B = basename(B), Mash = as.numeric(dist)) %>%
          dplyr::filter(A != B)
        g <- igraph::graph_from_data_frame(md %>% dplyr::filter(Mash < 0.05), directed = FALSE)
        if (igraph::gorder(g) > 0) {
          cl <- igraph::components(g)
          clusters <- tibble::tibble(
            name    = names(cl$membership),
            cluster = as.integer(cl$membership)
          ) %>%
            dplyr::mutate(SampleID = sub("^([^_]+)_.*$", "\\1", tools::file_path_sans_ext(name)))
          if (nrow(clusters) > 0) readr::write_csv(clusters, plasmid_clusters_csv)
          progress_tick("F_PLS", status = "clustered")
        }
      }
    }
    
    # Copy number scaffold (kept as NA unless mosdepth available)
    if (BIN_mosdepth != "" && nrow(clusters) > 0) {
      cn_rows <- list()
      for (sid in unique(clusters$SampleID)) {
        bam <- file.path(base_out, "bam", samples$Participant_id[samples$SampleID == sid][1], paste0(sid, ".markdup.bam"))
        if (!file.exists(bam)) next
        prefix <- file.path(dirname(bam), paste0(basename(bam), ".contig"))
        run_cmd(BIN_mosdepth, c("-t", opt$threads, "--by", "1000", "--fast-mode", "-n", prefix, bam),
                log_file = file.path(base_out, "logs", paste0("mosdepth_contig_", sid, ".log")), fail_ok = TRUE)
        chrom_depth <- NA_real_
        summ <- paste0(prefix, ".summary.txt")
        if (file.exists(summ)) {
          sm <- suppressMessages(readr::read_tsv(summ, show_col_types = FALSE))
          chrom_depth <- stats::median(sm$mean_coverage, na.rm = TRUE)
        }
        subc <- clusters %>% dplyr::filter(SampleID == sid)
        if (!is.na(chrom_depth) && nrow(subc) > 0) {
          cn_rows[[length(cn_rows) + 1]] <- subc %>% dplyr::transmute(SampleID = sid, contig = name, cluster, copy_number = NA_real_)
        }
        progress_tick("F_PLS", sid, "cn_est")
      }
      if (length(cn_rows)) readr::write_csv(dplyr::bind_rows(cn_rows), plasmid_cn_csv)
    } else {
      msg("↪  Plasmid CN: mosdepth unavailable or no clusters; skipping CN.")
    }
  } else {
    msg("↪  F) Fewer than 2 plasmid-like contigs; skipping clustering.")
  }
  progress_tick("F_PLS", status = "done")
