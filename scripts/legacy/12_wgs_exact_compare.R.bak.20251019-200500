plc_tbl <- if (!is.null(plc) && all(c("SampleID","cluster") %in% names(plc))) {
  plc %>%
    dplyr::group_by(SampleID) %>%
    dplyr::summarise(n_plasmid_clusters = dplyr::n_distinct(cluster), .groups = "drop")
} else {
  tibble::tibble(SampleID = character(), n_plasmid_clusters = integer())
}

sample_summary <- samples %>%
  dplyr::select(SampleID, Participant_id, tp_lab, tp_num, ST, n_contigs, n50, total_bp) %>%
  dplyr::mutate(across(c(SampleID, Participant_id, tp_lab), as.character)) %>%
  dplyr::left_join(vaf_tbl, by = "SampleID", relationship = "many-to-one") %>%
  dplyr::left_join(plc_tbl, by = "SampleID", relationship = "many-to-one")

readr::write_csv(sample_summary, file.path(rep_dir, "sample_summary.csv"))

progress_tick("K_POST", status = "done")
msg("✅ Pipeline complete (with skips as noted). See results/plots/_progress.png for a live heartbeat.")
