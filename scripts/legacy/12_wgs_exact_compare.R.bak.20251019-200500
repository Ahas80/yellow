# ---- Mash parser: accepts both `mash dist` (pair list) and `mash triangle` outputs ----
parse_mash <- function(path) {
  dt <- data.table::fread(path, header = FALSE, sep = "\t", fill = TRUE, showProgress = FALSE)
  
  # Case 1: pairwise list (A,B,dist,p,shared[,extra...])
  if (ncol(dt) >= 5) {
    data.table::setnames(dt, 1:5, c("A","B","dist","pvalue","shared_hashes"))
    out <- tibble::as_tibble(dt[, 1:5])
    out <- out %>%
      dplyr::mutate(
        A = tools::file_path_sans_ext(basename(A)),
        B = tools::file_path_sans_ext(basename(B))
      )
    return(out)
  }
  
  # Case 2: triangle/matrix form (first row/col are labels)
  if (ncol(dt) >= 2) {
    m <- as.data.frame(dt)
    col_ids <- as.character(unlist(m[1, -1], use.names = FALSE))
    row_ids <- as.character(m[-1, 1])
    m <- m[-1, -1, drop = FALSE]
    colnames(m) <- col_ids
    m$A <- row_ids
    long <- tidyr::pivot_longer(tibble::as_tibble(m), -A, names_to = "B", values_to = "dist")
    long$dist <- suppressWarnings(as.numeric(long$dist))
    long <- long %>% dplyr::filter(A != B)
    return(long)
  }
  
  stop("Unrecognized MASH output format at: ", path)
}

# -------- Heartbeat progress (CSV + small rolling bar chart) -------------------
progress_tick <- function(stage, pid = NA_character_, status = "tick") {
  if (!is.character(pid)) pid <- ifelse(is.na(pid), NA_character_, as.character(pid));

  pf <- file.path(base_out, "reports", "progress.csv")
  df <- read_progress(pf)
  if (nrow(df)) {
    df$stage  <- as.character(df$stage);
    df$pid    <- as.character(df$pid);
    df$status <- as.character(df$status);
  } else {
    df <- tibble::tibble(stage=character(), pid=character(), status=character(), t=as.POSIXct(character()));
  }
  df <- dplyr::bind_rows(
    df,
    tibble(
      stage  = as.character(stage),
      pid    = as.character(pid),
      status = as.character(status),
      t      = Sys.time()
    )
  )
  write_progress(df, pf)
  
  # tiny progress plot (unchanged)
  plotf <- file.path(plot_dir, "_progress.png")
  summ <- df %>% count(stage, status, name = "n")
  p <- ggplot(summ, aes(stage, n, fill = status)) +
    geom_col() + coord_flip() +
    labs(title = "Pipeline progress (rolling)", x = NULL, y = "Events") +
    theme_minimal(base_size = 10)
  write_plot(p, plotf, 6, 4, 150)
}
