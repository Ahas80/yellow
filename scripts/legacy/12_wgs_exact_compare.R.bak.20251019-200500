        msg("↪  %s missing from joint VCF; skipping consensus.", sid)
        next
      }
      if (!file.exists(cons_fa)) {
        tmp_vcf <- file.path(cons_dir, paste0("tmp_", sid, ".vcf.gz"))
        run_cmd(BIN_bcftools, c("view", "-s", sname, "-Oz", "-o", tmp_vcf, vcf_out), fail_ok = TRUE)
        run_cmd(BIN_bcftools, c("index", "-t", tmp_vcf), fail_ok = TRUE)
        cmd <- sprintf("%s consensus -f %s -s %s %s > %s",
                       shQuote(BIN_bcftools), shQuote(ref_fa), shQuote(sname),
                       shQuote(tmp_vcf), shQuote(cons_fa))
        run_cmd("/bin/sh", c("-c", cmd),
                log_file = file.path(base_out, "logs", paste0("consensus_redir_", pid, "_", sid, ".log")),
                fail_ok = TRUE)
      }
      cons_fastas <- c(cons_fastas, cons_fa)
    }
    # Concatenate multi-FASTA
    multi_fa <- file.path(base_out, "core", paste0("multi_", pid, ".fa"))
    if (!file.exists(multi_fa)) {
      cat("", file = multi_fa)
      for (fa in cons_fastas) {
        L <- readLines(fa, warn = FALSE)
        header <- paste0(">", tools::file_path_sans_ext(basename(fa)))
        seq <- paste(L[!startsWith(L, ">")], collapse = "")
        writeLines(c(header, gsub("(.{1,80})", "\\1\n", seq, perl = TRUE)), multi_fa, sep = "\n", useBytes = TRUE, append = TRUE)
      }
    }
    
    # Run Gubbins if available
    core_align <- file.path(base_out, "core", paste0("core_alignment_", pid, ".fa"))
    core_tree  <- file.path(base_out, "core", paste0("core_tree_", pid, ".nwk"))
    mask_bed   <- file.path(base_out, "masks", paste0("mask_catalog_", pid, ".bed"))
    if (BIN_gubbins != "") {
      outdir <- file.path(base_out, "core", paste0("gubbins_", pid))
      dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
      
      # Use long flags for run_gubbins.py, short flags for the compiled 'gubbins' binary
      if (grepl("run_gubbins", basename(BIN_gubbins), ignore.case = TRUE)) {
        gub_cmd <- sprintf('%s --threads %d --prefix %s %s',
                           shQuote(BIN_gubbins), opt$threads,
                           shQuote(paste0("run_", pid)), shQuote(multi_fa))
      } else {
        gub_cmd <- sprintf('%s -n %d -p %s %s',
                           shQuote(BIN_gubbins), opt$threads,
                           shQuote(paste0("run_", pid)), shQuote(multi_fa))
      }
      
      run_cmd("/bin/sh", c("-c", sprintf("cd %s && %s", shQuote(outdir), gub_cmd)),
              log_file = file.path(base_out, "logs", paste0("gubbins_", pid, ".log")),
              echo = TRUE, fail_ok = TRUE)
      
      cand_align <- list.files(outdir, pattern = "filtered_polymorphic_sites\\.fa(sta)?$", full.names = TRUE)
      if (length(cand_align)) safe_copy(cand_align[1], core_align, overwrite = TRUE)
      cand_tree <- list.files(outdir, pattern = "(final_tree|filtered_polymorphic_sites).*\\.tre$", full.names = TRUE)
      if (length(cand_tree)) safe_copy(cand_tree[1], core_tree, overwrite = TRUE)
      
      gff <- list.files(outdir, pattern = "recombination_predictions\\.gff$", full.names = TRUE)
      if (length(gff)) {
        gdat <- suppressWarnings(read_tsv(gff[1], comment = "#", col_names = FALSE, show_col_types = FALSE))
        if (nrow(gdat)) {
          bed <- gdat %>%
            transmute(chrom = X1, start = pmax(1, as.integer(X4) - 1), end = as.integer(X5))
          dir.create(dirname(mask_bed), recursive = TRUE, showWarnings = FALSE)
          write_tsv(bed, mask_bed, col_names = FALSE)
        }
      }
      
      # Fallback: if Gubbins produced nothing, still continue downstream with unmasked core
      if (!file.exists(core_align)) safe_copy(multi_fa, core_align, overwrite = TRUE)
      
    } else {
      msg("↪  gubbins not found; using unmasked multi-FASTA as core for PID %s", pid)
      safe_copy(multi_fa, core_align, overwrite = TRUE)
    }
    
    # snp-dists
    dist_tsv <- tempfile(fileext = ".tsv")
    if (BIN_snpdists != "" && file.exists(core_align)) {
      cmd <- sprintf("%s -c %s > %s", shQuote(BIN_snpdists), shQuote(core_align), shQuote(dist_tsv))
      run_cmd("/bin/sh", c("-c", cmd), log_file = file.path(base_out, "logs", paste0("snpdists_", pid, ".log")), fail_ok = TRUE)
    }
    ### >>> PATCH 5: snp-dists fallback without -c
    if (!file.exists(dist_tsv) || file.size(dist_tsv) == 0) {
      cmd2 <- sprintf("%s %s > %s", shQuote(BIN_snpdists), shQuote(core_align), shQuote(dist_tsv))
      run_cmd("/bin/sh", c("-c", cmd2),
              log_file = file.path(base_out, "logs", paste0("snpdists_plain_", pid, ".log")),
              fail_ok = TRUE)
    }
    ### <<< PATCH 5
    # Parse SNP matrix
    
    snp_mat <- NULL
    if (file.exists(dist_tsv)) {
      df <- suppressMessages(readr::read_tsv(dist_tsv, show_col_types = FALSE))
      if (nrow(df) > 0) { colnames(df)[1] <- "Sample"; snp_mat <- df }
    }
    
    pairs <- tibble()
    if (!is.null(snp_mat) && is.data.frame(snp_mat) && ncol(snp_mat) > 1) {
      long <- snp_mat %>%
        pivot_longer_safe(-Sample, names_to = "Sample2", values_to = "SNPs") %>%
        dplyr::filter(Sample != Sample2) %>%
        dplyr::mutate(pair_id = pair_key(Sample, Sample2)) %>%
        dplyr::arrange(pair_id) %>%
        dplyr::distinct(pair_id, .keep_all = TRUE)
      
      # build a BAM ↔ SampleID map from the names on bam_vec
      bam_map <- tibble(
        SampleID = names(bam_vec),
        bam      = unname(bam_vec)
      ) %>% filter(!is.na(bam) & bam != "")
      
      callable_tbl <- bam_map %>%
        dplyr::mutate(callable_bp = purrr::map_dbl(bam, ~ callable_bp_mosdepth(.x, opt$min_depth)))
      callable_map <- callable_tbl %>% dplyr::select(SampleID, callable_bp)
      
      long <- long %>%
        dplyr::left_join(callable_map, by = c("Sample" = "SampleID")) %>%
        dplyr::rename(callable_A = callable_bp) %>%
        dplyr::left_join(callable_map, by = c("Sample2" = "SampleID")) %>%
        dplyr::rename(callable_B = callable_bp)
      
      overlap_callable <- pmin(long$callable_A, long$callable_B, na.rm = TRUE)
      long$overlap_callable_bp <- overlap_callable
      long$SNPs_per_Mb <- ifelse(!is.na(overlap_callable) & overlap_callable > 0,
                                 long$SNPs / (overlap_callable / 1e6), NA_real_)
      long$Participant_id <- pid
      long$SampleA <- long$Sample
      long$SampleB <- long$Sample2
      
      pairs <- long %>%
        dplyr::select(Participant_id, SampleA, SampleB, SNPs,
                      callable_A, callable_B, overlap_callable_bp, SNPs_per_Mb)
      
      # Heatmap (if you actually want it here)
      mat <- as.matrix(as.data.frame(snp_mat[,-1]))
      rownames(mat) <- snp_mat$Sample
      png(file.path(plot_dir, paste0("core_snp_heatmap_", pid, ".png")), width = 1200, height = 1000, res = 150)
      invisible(safe_pheatmap(mat, clustering_distance_rows = "euclidean",
                     clustering_distance_cols = "euclidean",
                     main = paste("Core SNPs:", pid)))
      dev.off()
    } else {
      progress_tick("A_CORE", pid, "snp_matrix_empty")
    }
    
    # Time vs SNP distance
    time_plot_file <- file.path(plot_dir, paste0("time_vs_snp_distance_", pid, ".png"))
    if (!is.null(pairs) && nrow(pairs) > 0) {
      df_pid_tp <- samples %>% filter(Participant_id == pid) %>% select(SampleID, tp_num) %>% distinct()
      tlong <- pairs %>%
        left_join(df_pid_tp, by = c("SampleA" = "SampleID")) %>% rename(tp_A = tp_num) %>%
        left_join(df_pid_tp, by = c("SampleB" = "SampleID")) %>% rename(tp_B = tp_num) %>%
        mutate(delta_tp = abs(tp_B - tp_A)) %>% filter(!is.na(delta_tp))
      p <- ggplot(tlong, aes(delta_tp, SNPs_per_Mb)) +
        geom_point() + geom_smooth(method = "lm", se = FALSE) +
        labs(title = paste0("Time vs SNPs/Mb (", pid, ")"), x = "|Δ timepoint|", y = "SNPs per Mb")
      write_plot(p, time_plot_file, 6, 4)
    }
    
    core_align_out <- file.path(base_out, "core", paste0("core_alignment_", pid, ".fa"))
    if (file.exists(core_align)) safe_copy(core_align, core_align_out, overwrite = TRUE)
    if (file.exists(core_tree)) safe_copy(core_tree, file.path(base_out, "core", paste0("core_tree_", pid, ".nwk")), overwrite = TRUE)
    
    progress_tick("A_CORE", pid, "done")
    list(pid = pid, core_alignment = core_align_out,
         core_tree = if (file.exists(file.path(base_out, "core", paste0("core_tree_", pid, ".nwk")))) file.path(base_out, "core", paste0("core_tree_", pid, ".nwk")) else NA_character_,
         pairwise = pairs)
  })
  
  A_pairs <- bind_rows(purrr::compact(lapply(A_results, function(x) x$pairwise)))
  if (nrow(A_pairs) > 0) {
    A_pairs %>% group_by(Participant_id) %>%
      group_walk(~ readr::write_csv(.x, file.path(base_out, "core", paste0("core_snp_matrix_", unique(.x$Participant_id), ".csv"))))
  }
