    })
    if (!is.null(md) && nrow(md) > 0) {
      md <- md %>%
        dplyr::rename(Mash_distance = dist) %>%
        dplyr::mutate(pair_id = pair_key(A, B)) %>%
        dplyr::arrange(pair_id) %>%
