    cmd_tri <- sprintf("%s triangle -p %d %s > %s",
                       shQuote(BIN_mash), opt$threads,
                       shQuote(paste0(combined, ".msh")),
                       shQuote(all_dist))
    run_cmd("/bin/sh", c("-c", cmd_tri),
            log_file = file.path(base_out, "logs", "mash_triangle.log"),
            fail_ok = TRUE)
  }
  ### <<< PATCH 4
  
  
  if (file.exists(all_dist)) {
    md <- tryCatch(parse_mash(all_dist), error = function(e) {
      msg("↪ Mash output unreadable (%s); skipping Mash.", as.character(e))
